# test uci tree: protected 2-way speaker (mirrors the shipped overlay
# example). Devices match configs/camilladsp_protected_2way.yaml.
# New named-section schema: pipeline_step sections + `config pipeline`
# order list.

config camilladsp 'main'
	option enabled '1'
	option port '5000'
	option logspec 'warn,camillalib::alsa_backend::device=error'
	option samplerate '48000'
	option channels '2'
	option output_channels ''
	option chunksize '1024'
	option format 'S16_LE'
	option wav_header '1'
	option capture 'Inferno'
	option playback 'Inferno'

config mixer 'srcmix'
	option user_gains '1'
	option in '2'
	option out '2'
	list allow 'gain'

config mixroute                # woofer feed = (L+R)/2
	option mixer 'srcmix'
	option dest '0'
	option source '0'
	option gain '0.5'
config mixroute
	option mixer 'srcmix'
	option dest '0'
	option source '1'
	option gain '0.5'
config mixroute                # tweeter feed = (L+R)/2
	option mixer 'srcmix'
	option dest '1'
	option source '0'
	option gain '0.5'
config mixroute
	option mixer 'srcmix'
	option dest '1'
	option source '1'
	option gain '0.5'

config filter 'wf_lp'
	option type 'lrlp'
	option f '2300'
	option order '4'
config filter 'wf_fir'
	option type 'conv'
	option filename '/usr/share/camilladsp/coeffs/wf_fir.txt'
config filter 'wf_limit'
	option type 'limiter'
	option clip_limit '0.9'
config filter 'tw_hp'
	option type 'lrhp'
	option f '1900'
	option order '4'
config filter 'tw_notch10k'
	option type 'notch'
	option f '10000'
	option q '2.0'
config filter 'tw_peak17k'
	option type 'peak'
	option f '17000'
	option gain '-3.0'
	option q '2.0'
config filter 'tw_limit'
	option type 'limiter'
	option clip_limit '0.8'

config pipeline_step 'user_in0'
	option policy 'child'
	list channels '0'
	list allow 'gain'
	list allow 'volume'
	list allow 'peak'
	list allow 'hs'
	list allow 'ls'
	list allow 'notch'
	list allow 'ap'
	list allow 'bp'
	list allow 'hp'
	list allow 'lp'
	list allow 'conv'
	option max_steps '8'

config pipeline_step 'user_in1'
	option policy 'child'
	list channels '1'
	list allow 'gain'
	list allow 'volume'
	list allow 'peak'
	list allow 'hs'
	list allow 'ls'
	list allow 'notch'
	list allow 'ap'
	list allow 'bp'
	list allow 'hp'
	list allow 'lp'
	list allow 'conv'
	option max_steps '8'

config pipeline_step 'src_sel'
	option policy 'locked'
	option type 'Mixer'
	option mixer 'srcmix'

config pipeline_step 'wf_tail'
	option policy 'locked'
	option type 'Filter'
	list channels '0'
	list names 'wf_lp'
	list names 'wf_fir'
	list names 'wf_limit'

config pipeline_step 'tw_tail'
	option policy 'locked'
	option type 'Filter'
	list channels '1'
	list names 'tw_hp'
	list names 'tw_notch10k'
	list names 'tw_peak17k'
	list names 'tw_limit'

config pipeline
	list step 'user_in0'
	list step 'user_in1'
	list step 'src_sel'
	list step 'wf_tail'
	list step 'tw_tail'

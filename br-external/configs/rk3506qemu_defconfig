# RK3506-equivalent QEMU virt test firmware (see plan/plan.md, M1)
# Architecture: 3x Cortex-A7 + NEON/VFPv4, hard-float, musl
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y

# Toolchain: musl libc, kernel headers matching the Linux version below
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_INSTALL_LIBSTDCPP=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y

# System
BR2_TARGET_GENERIC_HOSTNAME="rk3506qemu"
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
# Merged /usr: OpenWrt components hardcode /sbin/ubusd, /sbin/netifd, ...
BR2_ROOTFS_MERGED_USR=y
# Network is managed by netifd (/etc/config/network), not BR2_SYSTEM_DHCP

# OpenWrt system stack (see plan/plan.md M2): virgilio-base ships the
# common base files (rc.d, /etc/config defaults, functions glue, ucode
# tools) and selects uci/procd/ubox/netifd/jsonfilter/ucode (+ubus, udebug,
# json-c, libnl via those).
BR2_PACKAGE_VIRGILIO_BASE=y
BR2_PACKAGE_WEBUI=y

# Tools
BR2_PACKAGE_NANO=y

# Applications (M3+)
BR2_PACKAGE_CAMILLADSP=y
BR2_PACKAGE_STATIME=y
BR2_PACKAGE_INFERNO=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_ARECORD=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_HTOP=y

# Board-specific rootfs overlay (network topology, rig services); the
# common base files come from the virgilio-base package
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_VIRGILIO_PATH)/board/rk3506qemu/rootfs-overlay"
# Flatten kernel modules OpenWrt-style for ubox kmodloader + regenerate modules.dep
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_VIRGILIO_PATH)/board/common/post-build.sh"
# Enable busybox ntpd (sysntpd service)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_VIRGILIO_PATH)/board/rk3506qemu/busybox.fragment"

# Kernel: mainline LTS; no arm32 virt_defconfig in mainline, multi_v7 has
# SMP + NEON + VIRTIO_MMIO + EXT4 + DEVTMPFS; our fragment adds audio/PTP
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.27"
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_VIRGILIO_PATH)/board/rk3506qemu/linux.fragment"

# Rootfs: ext4 only
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
# MPD web-radio source for the Dante transmitter (dual-NIC guests)
BR2_PACKAGE_MPD=y
# real MPD CLI (music player client; NB BR2_PACKAGE_MPC is the math lib)
BR2_PACKAGE_MPD_MPC=y
BR2_PACKAGE_MPD_ALSA=y
BR2_PACKAGE_MPD_CURL=y
BR2_PACKAGE_MPD_MAD=y
BR2_PACKAGE_MPD_FAAD2=y
BR2_PACKAGE_MPD_VORBIS=y
BR2_PACKAGE_MPD_OPUS=y
BR2_PACKAGE_MPD_FLAC=y
BR2_PACKAGE_MPD_ID3TAG=y
# WAV files/streams: since MPD 0.24 wav parsing is ONLY in the libsndfile
# plugin (the pcm decoder is MIME-only, no suffixes) — without this MPD
# neither indexes local .wav files nor plays wav URLs ("0 songs" / stop)
BR2_PACKAGE_MPD_LIBSNDFILE=y
# https streams: TLS backend for libcurl + CA bundle (else every https://
# URL fails: libcurl is built with TLS_NONE by default). OpenSSL, NOT
# mbedtls: Buildroot's liburl.mk passes --with-ca-bundle only in the
# openssl/wolfssl branches — mbedtls gets no trust store and every https
# verify fails. Choice members *depend on* the TLS lib — set both.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# webui daemon defaults (plan/webui.md §3). TLS: admin-supplied cert/key
# (no openssl CLI in the image); 'service webui reload' re-assembles the
# nginx server blocks after changes here.
config webui 'main'
	option socket '/run/webui.sock'
	option session_ttl '300'

config tls 'tls'
	option enable '0'
	option cert '/etc/webui/cert.pem'
	option key '/etc/webui/key.pem'


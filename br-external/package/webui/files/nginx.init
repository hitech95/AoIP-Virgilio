#!/bin/sh /etc/rc.common
# nginx: webui front (static, SCGI, auth-gated ws proxy).
# Replaces Buildroot's S50nginx (dropped in post-build).

START=84
STOP=16
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/nginx -g 'daemon off;'
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

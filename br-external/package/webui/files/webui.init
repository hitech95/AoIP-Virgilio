#!/bin/sh /etc/rc.common
# webui: ucode RPC daemon behind nginx (plan/webui.md §5) + nginx TLS
# assembly from uci. Server blocks live in /etc/nginx/conf.d/, assembled
# here so nginx.conf itself never changes on the device.

START=85
STOP=15
USE_PROCD=1

TPL=/usr/share/webui/nginx
CONF_D=/etc/nginx/conf.d

# Build /etc/nginx/conf.d from uci webui.tls:
#   enable=0 -> http.conf only
#   enable=1 -> https.conf (cert/key substituted) + redirect on :80
# Certificates are admin-supplied (no openssl CLI in the image).
setup_nginx_conf() {
	local enabled cert key
	config_load webui
	config_get_bool enabled tls enable 0
	config_get cert tls cert "/etc/webui/cert.pem"
	config_get key tls key "/etc/webui/key.pem"

	mkdir -p "$CONF_D"
	rm -f "$CONF_D"/webui-http.conf "$CONF_D"/webui-https.conf

	if [ "$enabled" = "1" ]; then
		if [ ! -f "$cert" ] || [ ! -f "$key" ]; then
			echo "webui: TLS enabled but cert '$cert' or key '$key' missing, falling back to HTTP" >&2
			cp "$TPL/nginx-http.conf" "$CONF_D/webui-http.conf"
			return 0
		fi
		sed -e "s|@CERT@|$cert|g" -e "s|@KEY@|$key|g" \
			"$TPL/nginx-https.conf.in" > "$CONF_D/webui-https.conf"
		cp "$TPL/nginx-redirect.conf" "$CONF_D/webui-http.conf"
	else
		cp "$TPL/nginx-http.conf" "$CONF_D/webui-http.conf"
	fi
}

start_service() {
	setup_nginx_conf

	# nginx (S84) starts before us (S85) with an empty conf.d -- bring
	# the assembled server blocks live. Harmless no-op if it isn't
	# running yet (S84 failed or reordered).
	/usr/sbin/nginx -s reload >/dev/null 2>&1

	procd_open_instance
	procd_set_param command /usr/bin/ucode -L /usr/share/webui/ucode /usr/bin/webuid
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# nginx is started by the companion /etc/init.d/nginx (S84, before webui);
# TLS changes need an explicit reload: 'service webui reload' re-assembles
# the config, tests it (nginx -t) and reloads nginx only when valid.
reload_service() {
	setup_nginx_conf
	if /usr/sbin/nginx -t >/dev/null 2>&1; then
		/usr/sbin/nginx -s reload
	else
		echo "webui: generated nginx config invalid, keeping the running one" >&2
		return 1
	fi
}

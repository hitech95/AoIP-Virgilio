+//! Locked-config manifest: opt-in protection of pipeline sub chains.
+//!
+//! A manifest partitions the pipeline into ordered sub chains, each with
+//! a policy:
+//!   - `locked`: steps (and the filter/mixer definitions they reference)
+//!     are pinned by a sha256 hash; position pinned. Anchors the gaps.
+//!   - `child`:  content editable within constraints (allow-listed filter
+//!     types, owned channels, max steps); position pinned to its slot.
+//!   - `free`:   like `child` but the whole run may relocate between the
+//!     gaps listed in the manifest.
+//!
+//! The manifest is generated from a config plus a policy spec by this
+//! same binary (`--make-manifest`), so the canonical form used for
+//! hashing is defined by one code path.
+//!
+//! Canonical form (single rule, used for every hash):
+//!   JSON, nulls stripped recursively, object keys sorted, whole-valued
+//!   floats normalized to integers, compact serialization; sha256 hex.
+//!
+//! When a manifest is active (started with `--manifest`), every config
+//! passing through `validate_config` is checked against it. Startup
+//! then aborts on mismatch; websocket/Reload edits are rejected.
+
+use std::collections::{BTreeMap, HashSet};
+use std::sync::OnceLock;
+
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value};
+
+use crate::config::{ConfigError, Configuration, PipelineStep};
+use crate::Res;
+
+pub const MANIFEST_VERSION: u32 = 2;
+
+static ACTIVE: OnceLock<Manifest> = OnceLock::new();
+
+// --------------------------------------------------------------------------
+// SHA-256 (self-contained, no external dependency)
+// --------------------------------------------------------------------------
+
+const SHA256_K: [u32; 64] = [
+    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4,
+    0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe,
+    0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f,
+    0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+    0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc,
+    0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b,
+    0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116,
+    0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7,
+    0xc67178f2,
+];
+
+fn sha256(data: &[u8]) -> [u8; 32] {
+    let mut h: [u32; 8] = [
+        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab,
+        0x5be0cd19,
+    ];
+    let bitlen = (data.len() as u64).wrapping_mul(8);
+    let mut msg = data.to_vec();
+    msg.push(0x80);
+    while msg.len() % 64 != 56 {
+        msg.push(0);
+    }
+    msg.extend_from_slice(&bitlen.to_be_bytes());
+    for chunk in msg.chunks_exact(64) {
+        let mut w = [0u32; 64];
+        for (i, word) in w.iter_mut().enumerate().take(16) {
+            *word = u32::from_be_bytes([
+                chunk[4 * i],
+                chunk[4 * i + 1],
+                chunk[4 * i + 2],
+                chunk[4 * i + 3],
+            ]);
+        }
+        for i in 16..64 {
+            let s0 = w[i - 15].rotate_right(7) ^ w[i - 15].rotate_right(18) ^ (w[i - 15] >> 3);
+            let s1 = w[i - 2].rotate_right(17) ^ w[i - 2].rotate_right(19) ^ (w[i - 2] >> 10);
+            w[i] = w[i - 16]
+                .wrapping_add(s0)
+                .wrapping_add(w[i - 7])
+                .wrapping_add(s1);
+        }
+        let (mut a, mut b, mut c, mut d, mut e, mut f, mut g, mut hh) =
+            (h[0], h[1], h[2], h[3], h[4], h[5], h[6], h[7]);
+        for i in 0..64 {
+            let s1 = e.rotate_right(6) ^ e.rotate_right(11) ^ e.rotate_right(25);
+            let ch = (e & f) ^ ((!e) & g);
+            let t1 = hh
+                .wrapping_add(s1)
+                .wrapping_add(ch)
+                .wrapping_add(SHA256_K[i])
+                .wrapping_add(w[i]);
+            let s0 = a.rotate_right(2) ^ a.rotate_right(13) ^ a.rotate_right(22);
+            let maj = (a & b) ^ (a & c) ^ (b & c);
+            let t2 = s0.wrapping_add(maj);
+            hh = g;
+            g = f;
+            f = e;
+            e = d.wrapping_add(t1);
+            d = c;
+            c = b;
+            b = a;
+            a = t1.wrapping_add(t2);
+        }
+        h[0] = h[0].wrapping_add(a);
+        h[1] = h[1].wrapping_add(b);
+        h[2] = h[2].wrapping_add(c);
+        h[3] = h[3].wrapping_add(d);
+        h[4] = h[4].wrapping_add(e);
+        h[5] = h[5].wrapping_add(f);
+        h[6] = h[6].wrapping_add(g);
+        h[7] = h[7].wrapping_add(hh);
+    }
+    let mut out = [0u8; 32];
+    for (i, word) in h.iter().enumerate() {
+        out[4 * i..4 * i + 4].copy_from_slice(&word.to_be_bytes());
+    }
+    out
+}
+
+fn sha256_hex(data: &[u8]) -> String {
+    let digest = sha256(data);
+    let mut s = String::with_capacity(64);
+    for byte in digest {
+        s.push_str(&format!("{byte:02x}"));
+    }
+    s
+}
+
+// --------------------------------------------------------------------------
+// Canonical form
+// --------------------------------------------------------------------------
+
+/// Canonicalize a JSON value: strip nulls recursively, sort object keys,
+/// normalize whole-valued floats to integers.
+fn canonicalize(value: Value) -> Value {
+    match value {
+        Value::Object(map) => {
+            let mut sorted: BTreeMap<String, Value> = BTreeMap::new();
+            for (key, val) in map {
+                if val.is_null() {
+                    continue;
+                }
+                sorted.insert(key, canonicalize(val));
+            }
+            let mut out = Map::with_capacity(sorted.len());
+            for (key, val) in sorted {
+                out.insert(key, val);
+            }
+            Value::Object(out)
+        }
+        Value::Array(items) => Value::Array(items.into_iter().map(canonicalize).collect()),
+        Value::Number(number) => {
+            if let Some(f) = number.as_f64()
+                && f.is_finite()
+                && f.fract() == 0.0
+                && f.abs() < 9.0e15
+            {
+                return Value::Number(serde_json::Number::from(f as i64));
+            }
+            Value::Number(number)
+        }
+        other => other,
+    }
+}
+
+fn canonical<T: Serialize>(value: &T) -> Value {
+    canonicalize(serde_json::to_value(value).unwrap_or(Value::Null))
+}
+
+fn hash_value(value: &Value) -> String {
+    sha256_hex(value.to_string().as_bytes())
+}
+
+// --------------------------------------------------------------------------
+// Manifest schema
+// --------------------------------------------------------------------------
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct HashEntry {
+    pub sha256: String,
+}
+
+/// Mixers region entry: hash of the region with route gains stripped
+/// for the mixers listed in `user_gains` only. Mixers NOT listed are
+/// hashed with their gains — fully locked. A candidate config is
+/// accepted when the same computation matches `sha256`.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct MixersEntry {
+    pub sha256: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub user_gains: Option<Vec<String>>,
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(tag = "policy")]
+pub enum SubChain {
+    #[serde(rename = "locked")]
+    Locked {
+        name: String,
+        sha256: String,
+        steps: Vec<Value>,
+    },
+    #[serde(rename = "child")]
+    Child {
+        name: String,
+        slot: usize,
+        channels: Vec<usize>,
+        allow: Vec<String>,
+        max_steps: usize,
+    },
+    #[serde(rename = "free")]
+    Free {
+        name: String,
+        gaps: Vec<usize>,
+        channels: Vec<usize>,
+        allow: Vec<String>,
+        max_steps: usize,
+    },
+}
+
+impl SubChain {
+    pub fn name(&self) -> &str {
+        match self {
+            SubChain::Locked { name, .. } => name,
+            SubChain::Child { name, .. } => name,
+            SubChain::Free { name, .. } => name,
+        }
+    }
+
+    /// (allowed channels, allowed filter types, max extra steps) for
+    /// editable sub chains; None for locked.
+    pub fn constraints(&self) -> Option<(&[usize], &[String], usize)> {
+        match self {
+            SubChain::Locked { .. } => None,
+            SubChain::Child {
+                channels,
+                allow,
+                max_steps,
+                ..
+            }
+            | SubChain::Free {
+                channels,
+                allow,
+                max_steps,
+                ..
+            } => Some((channels, allow, *max_steps)),
+        }
+    }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Manifest {
+    pub version: u32,
+    pub devices: HashEntry,
+    pub mixers: MixersEntry,
+    pub subchains: Vec<SubChain>,
+}
+
+// --------------------------------------------------------------------------
+// Activation
+// --------------------------------------------------------------------------
+
+/// Load a manifest file and activate it. Called once at startup when the
+/// `--manifest` option is given. Fails if a manifest is already active.
+pub fn load_and_activate(path: &str) -> Res<&'static Manifest> {
+    let file = std::fs::File::open(path)
+        .map_err(|e| ConfigError::new(&format!("Unable to open manifest file {path}: {e}")))?;
+    let manifest: Manifest = yaml_serde::from_reader(file)
+        .map_err(|e| ConfigError::new(&format!("Unable to parse manifest file {path}: {e}")))?;
+    if manifest.version != MANIFEST_VERSION {
+        return Err(ConfigError::new(&format!(
+            "Unsupported manifest version {} (expected {MANIFEST_VERSION})",
+            manifest.version
+        ))
+        .into());
+    }
+    if manifest.subchains.is_empty() {
+        return Err(ConfigError::new("Manifest has no subchains").into());
+    }
+    if !matches!(
+        manifest.subchains.last(),
+        Some(SubChain::Locked { .. })
+    ) {
+        return Err(ConfigError::new("The last subchain of a manifest must be locked").into());
+    }
+    if ACTIVE.set(manifest).is_err() {
+        return Err(ConfigError::new("A manifest is already active").into());
+    }
+    Ok(ACTIVE.get().unwrap())
+}
+
+/// The active manifest, if the daemon was started with `--manifest`.
+pub fn active() -> Option<&'static Manifest> {
+    ACTIVE.get()
+}
+
+// --------------------------------------------------------------------------
+// Validation
+// --------------------------------------------------------------------------
+
+/// Check a configuration against a manifest. Called from validate_config
+/// when a manifest is active; pure so it can be unit-tested.
+pub fn validate_against_manifest(conf: &Configuration, manifest: &Manifest) -> Result<(), String> {
+    // Devices are fully locked. The mixers region is pinned up to the
+    // route gains of the mixers listed in `user_gains` (free user
+    // state, e.g. source-mix selection: 100% ch0 / 100% ch1 /
+    // (ch0+ch1)/2 are just gains); mixers not listed are fully locked.
+    let devices_hash = hash_value(&canonical(&conf.devices));
+    if devices_hash != manifest.devices.sha256 {
+        return Err("devices section does not match the manifest".to_string());
+    }
+    let user_gains: HashSet<String> = manifest
+        .mixers
+        .user_gains
+        .clone()
+        .unwrap_or_default()
+        .into_iter()
+        .collect();
+    let mixers_hash = mixers_region_hash(conf, &user_gains);
+    if mixers_hash != manifest.mixers.sha256 {
+        return Err(
+            "mixers section does not match the manifest (only the route gains of \
+             user_gains mixers are editable)"
+                .to_string(),
+        );
+    }
+    if let Some(processors) = &conf.processors
+        && !processors.is_empty()
+    {
+        return Err("processors are not allowed in a locked pipeline".to_string());
+    }
+
+    let steps: Vec<PipelineStep> = conf.pipeline.clone().unwrap_or_default();
+    let step_values: Vec<Value> = steps.iter().map(|s| canonical(s)).collect();
+
+    // Phase A: match the locked runs, in manifest order. The steps
+    // between the end of one locked run and the start of the next form
+    // the slot of the editable sub chains living there.
+    let mut gaps: Vec<(usize, usize)> = Vec::new(); // gaps[k] = range before locked anchor k+1
+    let mut cursor = 0usize;
+    for subchain in &manifest.subchains {
+        let SubChain::Locked {
+            name,
+            sha256,
+            steps: expected,
+        } = subchain
+        else {
+            continue;
+        };
+        let n = expected.len();
+        let mut found: Option<usize> = None;
+        let mut p = cursor;
+        while p + n <= step_values.len() {
+            if (0..n).all(|i| step_values[p + i] == expected[i]) {
+                found = Some(p);
+                break;
+            }
+            p += 1;
+        }
+        let Some(start) = found else {
+            return Err(format!(
+                "locked subchain '{name}' is missing, modified or moved"
+            ));
+        };
+        // Pin the referenced filter/mixer definitions by hashing the run body.
+        let body = run_body(conf, name, &step_values[start..start + n], &user_gains);
+        if hash_value(&body) != *sha256 {
+            return Err(format!(
+                "locked subchain '{name}' does not match the manifest (content hash)"
+            ));
+        }
+        gaps.push((cursor, start));
+        cursor = start + n;
+    }
+
+    // The last subchain must be locked and nothing may follow it.
+    if cursor != step_values.len() {
+        return Err("steps found after the last locked subchain".to_string());
+    }
+
+    // Phase B: parse each gap into placeholder-headed runs and check
+    // them against the constraints of the editable sub chain they
+    // belong to.
+    let bus_channels = conf.devices.playback.channels();
+    let mut seen: HashSet<String> = HashSet::new();
+    for (gap_nr, &(start, end)) in gaps.iter().enumerate() {
+        if start == end {
+            continue; // empty gap
+        }
+        // slot 0 (before the first locked anchor) may hold editable
+        // groups, e.g. per-input-channel user EQ ahead of the mixer
+        let slot = gap_nr; // slot k sits after locked anchor k
+        let expected_here: Vec<&SubChain> = manifest
+            .subchains
+            .iter()
+            .filter(|sc| match sc {
+                SubChain::Child { slot: s, .. } => *s == slot,
+                SubChain::Free { gaps: g, .. } => g.contains(&slot),
+                SubChain::Locked { .. } => false,
+            })
+            .collect();
+        let mut current: Option<&SubChain> = None;
+        let mut step_count: usize = 0;
+        for idx in start..end {
+            let step = &step_values[idx];
+            if let Some(group) = placeholder_group(step, &expected_here) {
+                if !seen.insert(group.name().to_string()) {
+                    return Err(format!(
+                        "subchain '{}' appears more than once",
+                        group.name()
+                    ));
+                }
+                current = Some(group);
+                step_count = 0;
+                check_step_channels(step, group, bus_channels, "placeholder")?;
+                // extra filter names carried by the placeholder step are
+                // editable content of the group
+                if let Some(names) = step.get("names").and_then(Value::as_array) {
+                    check_filter_names(names.iter().skip(1), group, conf)?;
+                }
+                continue;
+            }
+            let Some(group) = current else {
+                return Err(format!(
+                    "step {idx} in slot {slot} is not preceded by a subchain placeholder"
+                ));
+            };
+            step_count += 1;
+            check_editable_step(step, group, conf, step_count, bus_channels)?;
+        }
+    }
+
+    // Every editable subchain must be present exactly once.
+    for subchain in &manifest.subchains {
+        if subchain.constraints().is_some() && !seen.contains(subchain.name()) {
+            return Err(format!(
+                "editable subchain '{}' is missing (no placeholder found)",
+                subchain.name()
+            ));
+        }
+    }
+
+    // Phase C: no unreferenced filter definitions.
+    let mut referenced: HashSet<String> = HashSet::new();
+    for step in &steps {
+        match step {
+            PipelineStep::Filter(fstep) => {
+                for name in &fstep.names {
+                    referenced.insert(name.clone());
+                }
+            }
+            PipelineStep::Mixer(mstep) => {
+                referenced.insert(mstep.name.clone());
+            }
+            PipelineStep::Processor(_) => {
+                return Err("processor steps are not allowed in a locked pipeline".to_string());
+            }
+        }
+    }
+    if let Some(filters) = &conf.filters {
+        for name in filters.keys() {
+            if !referenced.contains(name) {
+                return Err(format!("filter '{name}' is not used by any pipeline step"));
+            }
+        }
+    }
+    Ok(())
+}
+
+/// Body hashed for a locked run: name + steps + referenced definitions.
+/// Mixer definitions of `user_gains` mixers are embedded with their
+/// route gains stripped (gains are free user state); all other
+/// definitions are embedded verbatim.
+fn run_body(
+    conf: &Configuration,
+    name: &str,
+    step_values: &[Value],
+    user_gains: &HashSet<String>,
+) -> Value {
+    let mut filters = Map::new();
+    let mut mixers = Map::new();
+    for step_value in step_values {
+        if step_value.get("type").and_then(Value::as_str) == Some("Filter")
+            && let Some(names) = step_value.get("names").and_then(Value::as_array)
+        {
+            for n in names {
+                if let Some(fname) = n.as_str()
+                    && let Some(filters_map) = &conf.filters
+                    && let Some(def) = filters_map.get(fname)
+                {
+                    filters.insert(fname.to_string(), canonical(def));
+                }
+            }
+        }
+        if step_value.get("type").and_then(Value::as_str) == Some("Mixer")
+            && let Some(mname) = step_value.get("name").and_then(Value::as_str)
+            && let Some(mixers_map) = &conf.mixers
+            && let Some(def) = mixers_map.get(mname)
+        {
+            // gains are free user state: embed the mixer STRUCTURE only
+            let mut def_value = canonical(def);
+            if user_gains.contains(mname) {
+                strip_mixer_gains(&mut def_value);
+            }
+            mixers.insert(mname.to_string(), def_value);
+        }
+    }
+    let mut body = Map::new();
+    body.insert("name".to_string(), Value::String(name.to_string()));
+    body.insert("steps".to_string(), Value::Array(step_values.to_vec()));
+    body.insert("filters".to_string(), Value::Object(filters));
+    body.insert("mixers".to_string(), Value::Object(mixers));
+    canonicalize(Value::Object(body))
+}
+
+/// If the step leads with a placeholder name ("user_slot_<name>") of one
+/// of the expected groups, return that group. The step may carry extra
+/// filter names after the placeholder; those are editable content.
+fn placeholder_group<'a>(step: &Value, expected: &'a [&'a SubChain]) -> Option<&'a SubChain> {
+    if step.get("type").and_then(Value::as_str) != Some("Filter") {
+        return None;
+    }
+    let names = step.get("names").and_then(Value::as_array)?;
+    let name = names.first()?.as_str()?;
+    let suffix = name.strip_prefix("user_slot_")?;
+    expected.iter().find(|sc| sc.name() == suffix).copied()
+}
+
+/// Channels of a step, with an omitted list meaning all bus channels.
+fn effective_channels(step: &Value, bus_channels: usize) -> Result<Vec<usize>, String> {
+    match step.get("channels") {
+        None => Ok((0..bus_channels).collect()),
+        Some(Value::Array(chs)) => {
+            let mut out = Vec::with_capacity(chs.len());
+            for c in chs {
+                out.push(
+                    c.as_u64()
+                        .ok_or_else(|| "channel list contains a non-integer".to_string())?
+                        as usize,
+                );
+            }
+            Ok(out)
+        }
+        Some(_) => Err("channels must be a list".to_string()),
+    }
+}
+
+fn check_step_channels(
+    step: &Value,
+    group: &SubChain,
+    bus_channels: usize,
+    what: &str,
+) -> Result<(), String> {
+    let Some((allowed, _, _)) = group.constraints() else {
+        return Ok(());
+    };
+    let chs = effective_channels(step, bus_channels)?;
+    if chs.iter().all(|c| allowed.contains(c)) {
+        Ok(())
+    } else {
+        Err(format!(
+            "{what} of subchain '{}' uses channels outside its allowed set",
+            group.name()
+        ))
+    }
+}
+
+fn check_editable_step(
+    step: &Value,
+    group: &SubChain,
+    conf: &Configuration,
+    step_count: usize,
+    bus_channels: usize,
+) -> Result<(), String> {
+    let name = group.name();
+    let Some((_allowed, allow_types, max_steps)) = group.constraints() else {
+        return Err(format!("subchain '{name}' is not editable"));
+    };
+    if step.get("type").and_then(Value::as_str) != Some("Filter") {
+        return Err(format!("subchain '{name}' may only contain Filter steps"));
+    }
+    if step_count > max_steps {
+        return Err(format!(
+            "subchain '{name}' exceeds max_steps ({max_steps})"
+        ));
+    }
+    check_step_channels(step, group, bus_channels, "step")?;
+    let Some(names) = step.get("names").and_then(Value::as_array) else {
+        return Err(format!("Filter step in '{name}' has no filter names"));
+    };
+    check_filter_names(names.iter(), group, conf)
+}
+
+/// Check that each referenced filter exists and its type is allowed in
+/// the group.
+fn check_filter_names<'a, I>(names: I, group: &SubChain, conf: &Configuration) -> Result<(), String>
+where
+    I: Iterator<Item = &'a Value>,
+{
+    let name = group.name();
+    let Some((_, allow_types, _)) = group.constraints() else {
+        return Err(format!("subchain '{name}' is not editable"));
+    };
+    for n in names {
+        let Some(fname) = n.as_str() else {
+            return Err(format!("Filter step in '{name}' has a non-string name"));
+        };
+        let Some(filters) = &conf.filters else {
+            return Err(format!("filter '{fname}' is not defined"));
+        };
+        let Some(def) = filters.get(fname) else {
+            return Err(format!("filter '{fname}' is not defined"));
+        };
+        let ftype = canonical(def)
+            .get("type")
+            .and_then(Value::as_str)
+            .unwrap_or("?")
+            .to_string();
+        if !allow_types.contains(&ftype) {
+            return Err(format!(
+                "filter '{fname}' of type '{ftype}' is not allowed in subchain '{name}'"
+            ));
+        }
+    }
+    Ok(())
+}

+    #[test]
+    fn test_input_eq_before_mixer() {
+        // user EQ as two groups on the INPUT channels, ahead of the
+        // mixer (slot 0): [in0][in1][mixer][wf_tail][tw_tail]
+        let config = r#"
+devices:
+  samplerate: 48000
+  chunksize: 1024
+  capture:
+    type: RawFile
+    channels: 2
+    filename: /dev/zero
+    format: S16_LE
+  playback:
+    type: File
+    channels: 2
+    filename: /dev/null
+    format: S16_LE
+    wav_header: false
+mixers:
+  srcmix:
+    channels:
+      in: 2
+      out: 2
+    mapping:
+      - dest: 0
+        sources:
+          - channel: 0
+            gain: 0.5
+            scale: linear
+      - dest: 1
+        sources:
+          - channel: 1
+            gain: 0.5
+            scale: linear
+filters:
+  user_slot_user_in0:
+    type: Gain
+    parameters:
+      gain: 0
+  user_slot_user_in1:
+    type: Gain
+    parameters:
+      gain: 0
+  wf_lp:
+    type: BiquadCombo
+    parameters:
+      type: LinkwitzRileyLowpass
+      freq: 2300
+      order: 4
+  tw_hp:
+    type: BiquadCombo
+    parameters:
+      type: LinkwitzRileyHighpass
+      freq: 1900
+      order: 4
+pipeline:
+  - type: Filter
+    channels: [0]
+    names: [user_slot_user_in0]
+  - type: Filter
+    channels: [1]
+    names: [user_slot_user_in1]
+  - type: Mixer
+    name: srcmix
+  - type: Filter
+    channels: [0]
+    names: [wf_lp]
+  - type: Filter
+    channels: [1]
+    names: [tw_hp]
+"#;
+        // uci filter type names in the allow list: must be translated
+        let policy = r#"
+subchains:
+  - policy: child
+    name: user_in0
+    channels: [0]
+    allow: [gain, peak, hs, ls, notch, ap, conv, delay]
+    max_steps: 8
+  - policy: child
+    name: user_in1
+    channels: [1]
+    allow: [gain, peak, hs, ls, notch, ap, conv, delay]
+    max_steps: 8
+  - policy: locked
+    name: src_sel
+    first_step: 2
+    steps: 1
+  - policy: locked
+    name: wf_tail
+    first_step: 3
+    steps: 1
+  - policy: locked
+    name: tw_tail
+    first_step: 4
+    steps: 1
+"#;
+        let conf = with_conf(config);
+        let spec: PolicySpec = yaml_serde::from_str(policy).unwrap();
+        let manifest = generate_manifest(&conf, &spec).expect("input-EQ manifest should generate");
+        // translation happened: uci 'gain'/'peak' -> Gain/Biquad
+        let sc = &manifest.subchains[0];
+        match sc {
+            SubChain::Child { allow, slot, .. } => {
+                assert_eq!(*slot, 0);
+                assert!(allow.contains(&"Gain".to_string()));
+                assert!(allow.contains(&"Biquad".to_string()));
+                assert!(!allow.contains(&"gain".to_string()));
+            }
+            _ => panic!("expected child"),
+        }
+        assert!(validate_against_manifest(&conf, &manifest).is_ok());
+
+        // user EQ appended to input slot 0: accepted
+        let with_eq = config
+            .replace(
+                "  user_slot_user_in1:",
+                "  user_eq1:\n    type: Biquad\n    parameters:\n      type: Peaking\n      freq: 1000\n      gain: 3\n      q: 1\n  user_slot_user_in1:",
+            )
+            .replace(
+                "    names: [user_slot_user_in0]",
+                "    names: [user_slot_user_in0, user_eq1]",
+            );
+        let conf_eq = with_conf(&with_eq);
+        assert!(validate_against_manifest(&conf_eq, &manifest).is_ok());
+
+        // moving an input slot after the mixer: rejected (position lock)
+        let moved = config
+            .replace(
+                "  - type: Filter\n    channels: [0]\n    names: [user_slot_user_in0]\n",
+                "",
+            )
+            .replace(
+                "  - type: Mixer\n    name: srcmix",
+                "  - type: Mixer\n    name: srcmix\n  - type: Filter\n    channels: [0]\n    names: [user_slot_user_in0]",
+            );
+        let conf_moved = with_conf(&moved);
+        assert!(validate_against_manifest(&conf_moved, &manifest).is_err());
+
+        // swapping the two input groups within slot 0: allowed
+        let swapped = config
+            .replace(
+                "  - type: Filter\n    channels: [0]\n    names: [user_slot_user_in0]\n  - type: Filter\n    channels: [1]\n    names: [user_slot_user_in1]",
+                "  - type: Filter\n    channels: [1]\n    names: [user_slot_user_in1]\n  - type: Filter\n    channels: [0]\n    names: [user_slot_user_in0]",
+            );
+        let conf_swapped = with_conf(&swapped);
+        assert!(validate_against_manifest(&conf_swapped, &manifest).is_ok());
+    }
+

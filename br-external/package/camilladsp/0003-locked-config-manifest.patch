+// --------------------------------------------------------------------------
+// Manifest generation (--make-manifest)
+// --------------------------------------------------------------------------
+
+/// Policy spec: the vendor's declaration of the partition, rendered from
+/// uci by camilladsp-genconf. Locked sub chains are identified by their
+/// step range in the rendered config; editable ones carry constraints.
+/// A `free` group lists the locked anchor names it may relocate after.
+#[derive(Debug, Clone, Deserialize)]
+pub struct PolicySpec {
+    pub subchains: Vec<PolicyEntry>,
+    /// Mixers whose route gains are free user state (source-mix
+    /// selection). Absent/empty = every mixer fully locked.
+    #[serde(default)]
+    pub user_gains: Option<Vec<String>>,
+}
+
+#[derive(Debug, Clone, Deserialize)]
+#[serde(tag = "policy")]
+pub enum PolicyEntry {
+    #[serde(rename = "locked")]
+    Locked {
+        name: String,
+        first_step: usize,
+        steps: usize,
+    },
+    #[serde(rename = "child")]
+    Child {
+        name: String,
+        channels: Vec<usize>,
+        allow: Vec<String>,
+        max_steps: usize,
+    },
+    #[serde(rename = "free")]
+    Free {
+        name: String,
+        gaps: Vec<String>,
+        channels: Vec<usize>,
+        allow: Vec<String>,
+        max_steps: usize,
+    },
+}
+
+/// Translate a filter type from the policy spec to the camilladsp
+/// config type name used at validation time. Accepts the uci filter
+/// type names (as rendered by camilladsp-genconf) and passes the
+/// camilladsp names through.
+fn translate_allow(name: &str) -> Result<String, String> {
+    let translated = match name {
+        "gain" => "Gain",
+        "volume" => "Volume",
+        "conv" => "Conv",
+        "delay" => "Delay",
+        "hp" | "lp" | "hs" | "ls" | "peak" | "notch" | "ap" | "bp" => "Biquad",
+        "lrhp" | "lrlp" => "BiquadCombo",
+        "Gain" => "Gain",
+        "Biquad" => "Biquad",
+        "BiquadCombo" => "BiquadCombo",
+        "Conv" => "Conv",
+        "Delay" => "Delay",
+        _ => return Err(format!("unknown filter type '{name}' in allow list")),
+    };
+    Ok(translated.to_string())
+}
+
+fn translate_allow_list(allow: &[String]) -> Result<Vec<String>, String> {
+    let mut out = Vec::with_capacity(allow.len());
+    for name in allow {
+        out.push(translate_allow(name)?);
+    }
+    Ok(out)
+}
+
+/// Strip the per-route `gain` from one canonical mixer value.
+fn strip_mixer_gains(mixer: &mut Value) {
+    let Some(mapping) = mixer
+        .as_object_mut()
+        .and_then(|m| m.get_mut("mapping"))
+        .and_then(Value::as_array_mut)
+    else {
+        return;
+    };
+    for entry in mapping.iter_mut() {
+        let Some(sources) = entry
+            .as_object_mut()
+            .and_then(|e| e.get_mut("sources"))
+            .and_then(Value::as_array_mut)
+        else {
+            continue;
+        };
+        for src in sources.iter_mut() {
+            if let Some(obj) = src.as_object_mut() {
+                obj.remove("gain");
+            }
+        }
+    }
+}
+
+/// Canonical mixers value with route gains stripped — but only for the
+/// mixers whose gains are free user state (source-mix selection).
+/// Mixers not in `user_gains` are hashed with their gains: fully
+/// locked.
+fn mixers_canonical(conf: &Configuration, user_gains: &HashSet<String>) -> Value {
+    let mut value = canonical(&conf.mixers);
+    if let Some(mixers_map) = value.as_object_mut() {
+        for (name, mixer) in mixers_map.iter_mut() {
+            if user_gains.contains(name) {
+                strip_mixer_gains(mixer);
+            }
+        }
+    }
+    value
+}
+
+fn mixers_region_hash(conf: &Configuration, user_gains: &HashSet<String>) -> String {
+    hash_value(&mixers_canonical(conf, user_gains))
+}
+
+/// Build a manifest from a validated configuration and a policy spec.
+/// Self-checks by validating the config against the result.
+pub fn generate_manifest(conf: &Configuration, spec: &PolicySpec) -> Result<Manifest, String> {
+    if spec.subchains.is_empty() {
+        return Err("policy spec has no subchains".to_string());
+    }
+    // user-gain mixers must exist
+    let user_gains: HashSet<String> = spec.user_gains.clone().unwrap_or_default().into_iter().collect();
+    if let Some(mixers_map) = &conf.mixers {
+        for name in &user_gains {
+            if !mixers_map.contains_key(name) {
+                return Err(format!("user_gains references unknown mixer '{name}'"));
+            }
+        }
+    }
+    let steps: Vec<PipelineStep> = conf.pipeline.clone().unwrap_or_default();
+    let step_values: Vec<Value> = steps.iter().map(|s| canonical(s)).collect();
+
+    // Map anchor names to their slot index (1-based, in order).
+    let mut anchor_slots: BTreeMap<String, usize> = BTreeMap::new();
+    let mut counter = 0usize;
+    for entry in &spec.subchains {
+        if let PolicyEntry::Locked { name, .. } = entry {
+            counter += 1;
+            anchor_slots.insert(name.clone(), counter);
+        }
+    }
+
+    let mut subchains: Vec<SubChain> = Vec::new();
+    let mut anchor_count = 0usize;
+    let mut previous_locked_end = 0usize;
+    for entry in &spec.subchains {
+        match entry {
+            PolicyEntry::Locked {
+                name,
+                first_step,
+                steps: n,
+            } => {
+                if *n == 0 {
+                    return Err(format!("locked subchain '{name}' has zero steps"));
+                }
+                if *first_step < previous_locked_end || *first_step + *n > step_values.len() {
+                    return Err(format!(
+                        "locked subchain '{name}' step range {first_step}..{} is out of range or overlaps the previous locked run",
+                        first_step + n
+                    ));
+                }
+                let run = &step_values[*first_step..*first_step + *n];
+                let body = run_body(conf, name, run, &user_gains);
+                subchains.push(SubChain::Locked {
+                    name: name.clone(),
+                    sha256: hash_value(&body),
+                    steps: run.to_vec(),
+                });
+                previous_locked_end = *first_step + *n;
+                anchor_count += 1;
+            }
+            PolicyEntry::Child {
+                name,
+                channels,
+                allow,
+                max_steps,
+            } => {
+                if channels.is_empty() || allow.is_empty() || *max_steps == 0 {
+                    return Err(format!(
+                        "child subchain '{name}' needs channels, allow and max_steps"
+                    ));
+                }
+                let allow = translate_allow_list(allow)?;
+                subchains.push(SubChain::Child {
+                    name: name.clone(),
+                    slot: anchor_count,
+                    channels: channels.clone(),
+                    allow,
+                    max_steps: *max_steps,
+                });
+            }
+            PolicyEntry::Free {
+                name,
+                gaps,
+                channels,
+                allow,
+                max_steps,
+            } => {
+                let mut slot_gaps = Vec::new();
+                for g in gaps {
+                    let Some(slot) = anchor_slots.get(g) else {
+                        return Err(format!(
+                            "free subchain '{name}' references unknown anchor '{g}'"
+                        ));
+                    };
+                    slot_gaps.push(*slot);
+                }
+                let allow = translate_allow_list(allow)?;
+                subchains.push(SubChain::Free {
+                    name: name.clone(),
+                    gaps: slot_gaps,
+                    channels: channels.clone(),
+                    allow,
+                    max_steps: *max_steps,
+                });
+            }
+        }
+    }
+    if !matches!(subchains.last(), Some(SubChain::Locked { .. })) {
+        return Err("the last subchain must be locked".to_string());
+    }
+
+    let manifest = Manifest {
+        version: MANIFEST_VERSION,
+        devices: HashEntry {
+            sha256: hash_value(&canonical(&conf.devices)),
+        },
+        mixers: MixersEntry {
+            sha256: mixers_region_hash(conf, &user_gains),
+            user_gains: if user_gains.is_empty() {
+                None
+            } else {
+                Some(user_gains.into_iter().collect())
+            },
+        },
+        subchains,
+    };
+    // Self-check: the config we just hashed must validate cleanly.
+    validate_against_manifest(conf, &manifest)?;
+    Ok(manifest)
+}
+
+/// Load a config and a policy spec from files and produce the manifest
+/// as pretty JSON (used by --make-manifest).
+pub fn make_manifest(config_path: &str, policy_path: &str) -> Res<String> {
+    let conf = crate::config::load_validate_config(config_path)?;
+    let policy_data = std::fs::read_to_string(policy_path).map_err(|e| {
+        ConfigError::new(&format!("Unable to read policy spec {policy_path}: {e}"))
+    })?;
+    let spec: PolicySpec = yaml_serde::from_str(&policy_data).map_err(|e| {
+        ConfigError::new(&format!("Unable to parse policy spec {policy_path}: {e}"))
+    })?;
+    let manifest = generate_manifest(&conf, &spec).map_err(|e| ConfigError::new(&e))?;
+    serde_json::to_string_pretty(&manifest)
+        .map_err(|e| ConfigError::new(&format!("Unable to serialize manifest: {e}")).into())
+}

+    #[test]
+    fn test_free_group_relocation() {
+        // add a free group allowed after src_sel or wf_tail
+        let yaml = BASE_CONFIG
+            .replace(
+                "  user_slot_user_tw:",
+                "  user_slot_user_x:\n    type: Gain\n    parameters:\n      gain: 0\n  user_slot_user_tw:",
+            )
+            .replace(
+                "  - type: Filter\n    channels: [0]\n    names: [user_slot_user_wf]",
+                "  - type: Filter\n    channels: [0]\n    names: [user_slot_user_wf]\n  - type: Filter\n    channels: [0]\n    names: [user_slot_user_x]",
+            );
+        let conf = with_conf(&yaml);
+        let policy = BASE_POLICY
+            .replace(
+                "  - policy: locked
+    name: wf_tail
+    first_step: 2",
+                "  - policy: free
+    name: user_x
+    gaps: [src_sel, wf_tail]
+    channels: [0]
+    allow: [Gain, Biquad, BiquadCombo, Conv, Delay]
+    max_steps: 4
+  - policy: locked
+    name: wf_tail
+    first_step: 3",
+            )
+            .replace(
+                "  - policy: locked
+    name: tw_tail
+    first_step: 4",
+                "  - policy: locked
+    name: tw_tail
+    first_step: 5",
+            );
+        let spec: PolicySpec = yaml_serde::from_str(&policy).unwrap();
+        let manifest = generate_manifest(&conf, &spec).expect("free manifest should generate");
+        assert!(validate_against_manifest(&conf, &manifest).is_ok());
+
+        // relocate the free run into gap 2 (after wf_tail) — still allowed
+        let moved = yaml
+            .replace(
+                "  - type: Filter\n    channels: [0]\n    names: [user_slot_user_wf]\n  - type: Filter\n    channels: [0]\n    names: [user_slot_user_x]",
+                "  - type: Filter\n    channels: [0]\n    names: [user_slot_user_wf]",
+            )
+            .replace(
+                "  - type: Filter\n    channels: [1]\n    names: [user_slot_user_tw]",
+                "  - type: Filter\n    channels: [0]\n    names: [user_slot_user_x]\n  - type: Filter\n    channels: [1]\n    names: [user_slot_user_tw]",
+            );
+        let conf_moved = with_conf(&moved);
+        assert!(validate_against_manifest(&conf_moved, &manifest).is_ok());
+
+        // forbid gap 2: regenerate a manifest allowing only gap 1
+        let policy2 = policy.replace("gaps: [src_sel, wf_tail]", "gaps: [src_sel]");
+        let spec2: PolicySpec = yaml_serde::from_str(&policy2).unwrap();
+        let manifest2 = generate_manifest(&conf, &spec2).unwrap();
+        assert!(validate_against_manifest(&conf_moved, &manifest2).is_err());
+    }
+}

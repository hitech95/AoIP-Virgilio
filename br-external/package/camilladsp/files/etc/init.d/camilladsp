#!/bin/sh /etc/rc.common
# camilladsp service: generates /tmp/camilladsp.yml (and, when uci
# declares sub chains, the policy + manifest) from uci, then runs the
# DSP engine under procd supervision (respawn).
#
# Protected pipeline chain (see docs/camilladsp.md "Protected pipeline"):
#   genconf (uci) -> /tmp/camilladsp.yml + /tmp/camilladsp.policy
#   camilladsp --make-manifest -> /tmp/camilladsp.manifest
#   camilladsp ... --manifest -> enforces it on every config change

START=75
STOP=25
USE_PROCD=1

EXTRA_COMMANDS="check"
EXTRA_HELP="	check	self-manage per the event lifecycle (docs/lifecycle.md):
		  start when not running + PTP locked + netdev addressed,
		  restart when the advertised IPv4 drifted, else silent"

CONFFILE=/tmp/camilladsp.yml
POLICYFILE=/tmp/camilladsp.policy
MANIFESTFILE=/tmp/camilladsp.manifest
ADDRFILE=/tmp/camilladsp.resolved-addr

# Regenerate the manifest if a policy exists (sub chains declared).
# Returns 0 on success (or when unprotected), 1 on failure.
regen_manifest() {
	if [ ! -f "$POLICYFILE" ]; then
		rm -f "$MANIFESTFILE"
		return 0
	fi
	if ! /usr/bin/camilladsp "$CONFFILE" --make-manifest "$POLICYFILE" \
		> "$MANIFESTFILE.new" 2>/dev/null; then
		echo "camilladsp: manifest generation failed, config kept" >&2
		rm -f "$MANIFESTFILE.new"
		return 1
	fi
	mv "$MANIFESTFILE.new" "$MANIFESTFILE"
	return 0
}

start_service() {
	local enabled port logspec wsaddr gain gain_arg

	config_load camilladsp
	config_get enabled main enabled 1
	config_get port main port 5000
	# websocket bind address. The WS API has NO authentication: bind to
	# loopback (product default) so only local tools (web UI, preset
	# daemon) can reach it. The dev rig overrides this to 0.0.0.0 to
	# use the forwarded port.
	config_get wsaddr main ws_address 127.0.0.1
	# flexi_logger spec (camilladsp ignores RUST_LOG, that env only
	# configures the inferno instance inside the ALSA plugin). Default
	# silences the short-read warnings of the inferno capture loop.
	config_get logspec main logspec 'warn,camillalib::alsa_backend::device=error'
	config_get gain main gain ''
	gain_arg=""
	[ -n "$gain" ] && gain_arg="-g $gain"

	[ "$enabled" = "1" ] || return 0

	/usr/bin/camilladsp-genconf "$CONFFILE" || return 1
	regen_manifest || return 1

	local manifest_arg=""
	[ -f "$MANIFESTFILE" ] && manifest_arg="--manifest $MANIFESTFILE"

	# extra environment for the daemon, e.g. INFERNO_* settings that end up
	# in the inferno ALSA plugin instance hosted by camilladsp
	# (values must not contain spaces)
	local _envs=""
	_env_cb() { _envs="${_envs}${_envs:+ }$1"; }
	config_list_foreach main env _env_cb

	# genconf sidecar (/tmp/camilladsp.env): generated INFERNO_* settings for
	# 'Inferno' device specs; uci 'list env' entries above take precedence
	if [ -f /tmp/camilladsp.env ]; then
		while IFS= read -r _line; do
			[ -n "$_line" ] || continue
			_k="${_line%%=*}"
			case " $_envs " in *" $_k="*) continue ;; esac
			_envs="${_envs}${_envs:+ }$_line"
		done < /tmp/camilladsp.env
	fi

	# Persistent state location for the hosted inferno instance
	# (rx_subscriptions.toml keyed by factory device id): uci
	# inferno.main.state_dir -> INFERNO_STATE_PATH (inferno patch
	# 0002-state-storage-env-path). The end state is the user-data volume
	# mounted at /opt/user_data (RW ubifs on real hardware), which also
	# hosts camilladsp user configs/filters. Without it, daemons started
	# without HOME would fall back to /.local at the rootfs root.
	config_load inferno
	config_get state_dir main state_dir /opt/user_data
	mkdir -p "$state_dir"
	case " $_envs " in *" INFERNO_STATE_PATH="*) ;; *)
		_envs="INFERNO_STATE_PATH=$state_dir${_envs:+ $_envs}" ;;
	esac

	# Single rendering point of the advertised-address baseline: every
	# start of this service records the IPv4 the fresh inferno instance
	# resolves at PCM open (first global, else first any — mirrors
	# inferno patch 0004). `check` and the hotplug handlers compare
	# against it; an addressless start (boot before zcip/DHCP) leaves it
	# absent so the first addressed `check` converges with one restart.
	. /usr/lib/camilladsp/inferno-net.sh
	local seed_dev seed_addr
	seed_dev=$(cdsp_inferno_dev)
	seed_addr=$(cdsp_preferred_addr "$seed_dev")
	[ -n "$seed_addr" ] || seed_addr=$(cdsp_preferred_addr_any "$seed_dev")
	if [ -n "$seed_addr" ]; then
		echo "$seed_addr" > "$ADDRFILE"
	else
		rm -f "$ADDRFILE"
	fi

	procd_open_instance
	procd_set_param command /usr/bin/camilladsp "$CONFFILE" -p "$port" -a "$wsaddr" \
		--custom_log_spec "$logspec" $gain_arg $manifest_arg
	[ -n "$_envs" ] && procd_set_param env $_envs
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# Reload without restart: regenerate config, then SIGHUP the running process
# (camilladsp applies new settings without interrupting processing when
# possible). NB: FIR coefficients are cached by filename — to update coeffs,
# the fir_file path must change.
# With a manifest active, SIGHUP validates the new config against the
# manifest loaded at STARTUP: if the vendor (locked) content changed, the
# manifest changed too and the daemon must restart to pick it up.
reload_service() {
	local enabled

	config_load camilladsp
	config_get enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	/usr/bin/camilladsp-genconf "$CONFFILE" || return 1

	if [ -f "$POLICYFILE" ]; then
		/usr/bin/camilladsp "$CONFFILE" --make-manifest "$POLICYFILE" \
			> "$MANIFESTFILE.new" 2>/dev/null || {
			echo "camilladsp: manifest generation failed, keeping old config" >&2
			rm -f "$MANIFESTFILE.new"
			return 1
		}
		if [ -f "$MANIFESTFILE" ] && ! cmp -s "$MANIFESTFILE.new" "$MANIFESTFILE"; then
			echo "camilladsp: locked content changed, restarting to load the new manifest" >&2
			mv "$MANIFESTFILE.new" "$MANIFESTFILE"
			restart
			return
		fi
		mv "$MANIFESTFILE.new" "$MANIFESTFILE"
	fi

	procd_send_signal camilladsp '' SIGHUP
}

# --- event-driven self-management ------------------------------------------

ptp_locked() {
	case "$(ubus call ptp status 2>/dev/null | jsonfilter -e '@.locked' 2>/dev/null)" in
	true|1) return 0 ;;
	esac
	return 1
}

# Is the real camilladsp binary running? NB: rc.common executes this
# file under the process name of the script itself (comm = "camilladsp"),
# so pidof matches THIS shell — and busybox runs applets as in-process
# forks, so command substitutions and pipeline stages impersonate the
# name as well. Discriminate by the actual executable: the daemon's
# /proc/<pid>/exe is /usr/bin/camilladsp, every shell impersonator's is
# busybox. (The hotplug handlers don't need this — their own process
# names differ from "camilladsp".)
cdsp_running() {
	local p
	for p in $(pidof camilladsp 2>/dev/null); do
		[ "$(readlink /proc/$p/exe 2>/dev/null)" = "/usr/bin/camilladsp" ] && return 0
	done
	return 1
}

# `check` — the ONE decision point of the hotplug lifecycle
# (docs/lifecycle.md): both hotplug dispatchers (netifd iface, procd ptp)
# and operators call this. Idempotent and order-tolerant; all starts and
# drift restarts funnel through start_service above, which alone renders
# and seeds the advertised-address baseline.
check() {
	local enabled dev now

	config_load camilladsp
	config_get enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	# clock first: without it the inferno plugin stalls in hw_params
	# (ETIMEDOUT) and crash-loops
	ptp_locked || return 0

	. /usr/lib/camilladsp/inferno-net.sh
	dev=$(cdsp_inferno_dev)
	[ -n "$dev" ] || return 0

	# the netdev must be link-up: a downed link means nothing to
	# advertise AND nothing to serve — and on a grandmaster-configured
	# box statime keeps self-clocking through outages (usrvclock is a
	# local socket), so the locked flag alone would lie here and the
	# 60 s locked heartbeat would restart the DSP onto a dead link
	cdsp_netdev_up "$dev" || return 0

	now=$(cdsp_preferred_addr "$dev")
	[ -n "$now" ] || now=$(cdsp_preferred_addr_any "$dev")
	# addressless: nothing to advertise yet (and a restart into a
	# BIND_IP-less netdev would crash-loop — inferno expects an address)
	[ -n "$now" ] || return 0

	if cdsp_running; then
		# running: inferno resolves its advertised address once at
		# start — a restart IS the re-resolution
		if [ "$now" != "$(cat "$ADDRFILE" 2>/dev/null)" ]; then
			logger -t camilladsp "check: address $(cat "$ADDRFILE" 2>/dev/null || echo none) -> $now on $dev, restarting"
			restart
		fi
	else
		logger -t camilladsp "check: starting (PTP locked, $now)"
		start
	fi
}

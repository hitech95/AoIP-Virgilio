#!/usr/bin/ucode -S
/*
 * camilladsp-genconf - generate the camilladsp v4 config (JSON, a YAML
 * subset) + policy spec + inferno env sidecar from uci (config
 * camilladsp). Default output: /tmp/camilladsp.yml.
 *
 * uci schema (named sections; NO backward-compatible parsing of the old
 * anonymous-section schema):
 *
 *   config camilladsp 'main'     devices + global settings
 *   config mixer '<name>'        one mixer (in, out, user_gains)
 *   config filter '<name>'       one filter (type + params, description)
 *   config mixroute              one mixer source contribution
 *                                (mixer, dest, source, gain, ...)
 *   config pipeline              pipeline ORDER: one 'list step' entry
 *                                per pipeline_step, in order
 *   config pipeline_step '<n>'   one pipeline step; the section id is
 *                                the step (and sub chain) name:
 *                                  option policy  locked | child | free
 *                                  option type    Filter | Mixer   (locked)
 *                                  option mixer   <mixer-name>     (Mixer)
 *                                  list channels  bus channels
 *                                  list names     filter refs (locked:
 *                                  fixed chain; child/free: user filters
 *                                  rendered after the user_slot_<n>
 *                                  placeholder anchor)
 *                                  list allow / max_steps / (free)
 *                                  list allowed_after <locked step names>
 *                                  option label   human name ->
 *                                  rendered as the step description
 *
 * A config where NO step carries `option policy` is an unprotected
 * upstream-style config (fully editable, no policy file). When any step
 * carries a policy, every step must. Each locked step is its own
 * single-step anchor; a child/free step IS one editable slot (its
 * section id names it).
 *
 * Outputs: <out> (JSON), <out minus .yml>.policy (only for protected
 * configs), <out minus .yml>.env (inferno sidecar). Errors -> stderr
 * prefixed 'camilladsp-genconf: ', exit 1.
 *
 * Self-contained ucode program (the target ucode has no module search
 * path for .uc files).
 */

import { writefile } from "fs";
import * as uci from "uci";

const VENDOR_COEFF_PREFIX = "/usr/share/camilladsp/coeffs";

function fail(msg) {
	die(msg);
}

function words(s) {
	if (type(s) == "array")
		return filter(s, (w) => length(`${w}`) > 0);
	return filter(split(`${s ?? ""}`, /\s+/), (w) => length(w) > 0);
}

function has_word(list, w) {
	for (let x in list)
		if (x == w) return true;
	return false;
}

/*
 * uci string -> JSON number, preserving the written form: integers
 * ("48000") stay int, decimals ("0.5") become double. Unparseable
 * values pass through as strings (camilladsp will reject them).
 */
function num(v, dflt) {
	if (v == null || v == "" || type(v) == "array" || type(v) == "object")
		return dflt;
	let s = `${v}`;
	if (match(s, /^\s*-?[0-9]+\s*$/))
		return int(s);
	if (match(s, /^\s*-?([0-9]+\.?[0-9]*|\.[0-9]+)([eE][+-]?[0-9]+)?\s*$/)) {
		let n = json(s);
		return (n == null) ? s : n;
	}
	return s;
}

/* "<path>.yml" -> "<path>" (only ONE trailing .yml is stripped) */
function stem(path) {
	return (substr(path, length(path) - 4) == ".yml")
		? substr(path, 0, length(path) - 4) : path;
}

function section(cursor, config, name) {
	try { cursor.load(config); } catch (e) {}
	try { return cursor.get_all(config, name) ?? {}; } catch (e) { return {}; }
}

function sections(cursor, config, stype) {
	let out = [];
	cursor.foreach(config, stype, (s) => { push(out, s); });
	return out;
}

/* ---- model collection ----------------------------------------------------- */

function collect(cursor) {
	try { cursor.load("camilladsp"); } catch (e) {}

	let main = section(cursor, "camilladsp", "main");

	let m = {
		main: {
			channels: main.channels ?? "2",
			output_channels: main.output_channels ?? "",
			samplerate: main.samplerate ?? "44100",
			chunksize: main.chunksize ?? "1024",
			format: main.format ?? "S16_LE",
			/* true when uci carries an explicit format option (the .env
			 * depth mapping distinguishes set vs unset; `format` itself
			 * is defaulted to S16_LE for device rendering) */
			format_set: (main.format != null && `${main.format}` != ""),
			wav_header: main.wav_header ?? "1",
			capture: main.capture ?? "RawFile:/dev/zero",
			playback: main.playback ?? "File:/dev/null",
			/* output_channels falls back to channels */
			pbch: (main.output_channels != null && `${main.output_channels}` != "")
				? `${main.output_channels}` : (main.channels ?? "2")
		},
		/* pipeline order: the 'list step' entries, in order */
		order: [],
		mixers: {}, mixer_order: [],
		filters: {}, filter_order: [],
		routes: [],
		steps: {}
	};

	/* pipeline order: the 'list step' entries of the (anonymous)
	 * `config pipeline` section, in order */
	let order = [];
	for (let s in sections(cursor, "camilladsp", "pipeline"))
		order = (type(s.step) == "array") ? s.step : words(s.step);
	m.order = order;

	for (let s in sections(cursor, "camilladsp", "mixer")) {
		m.mixers[s[".name"]] = {
			in: `${s.in ?? ""}`, out: `${s.out ?? ""}`,
			user_gains: `${s.user_gains ?? ""}`,
			/* free route fields for user_gains mixers ("gain" implied;
			 * "mute" is the only extra the manifest knows) */
			allow: filter(
				map((type(s.allow) == "array") ? s.allow : words(s.allow ?? ""),
					(a) => lc(`${a}`)),
				(a) => a == "mute"
			)
		};
		push(m.mixer_order, s[".name"]);
	}

	for (let s in sections(cursor, "camilladsp", "filter")) {
		m.filters[s[".name"]] = {
			type: `${s.type ?? ""}`,
			f: `${s.f ?? ""}`, q: `${s.q ?? ""}`, gain: `${s.gain ?? ""}`,
			order: `${s.order ?? ""}`, slope: `${s.slope ?? ""}`,
			inverted: `${s.inverted ?? ""}`, mute: `${s.mute ?? ""}`,
			filename: `${s.filename ?? ""}`, clip_limit: `${s.clip_limit ?? ""}`,
			fader: `${s.fader ?? ""}`, ramp_time: `${s.ramp_time ?? ""}`,
			limit: `${s.limit ?? ""}`,
			description: `${s.description ?? ""}`
		};
		push(m.filter_order, s[".name"]);
	}

	for (let s in sections(cursor, "camilladsp", "mixroute"))
		push(m.routes, {
			mixer: `${s.mixer ?? ""}`, dest: `${s.dest ?? ""}`,
			source: `${s.source ?? ""}`, gain: `${s.gain ?? ""}`,
			inverted: `${s.inverted ?? ""}`, mute: `${s.mute ?? ""}`
		});

	for (let s in sections(cursor, "camilladsp", "pipeline_step")) {
		m.steps[s[".name"]] = {
			policy: `${s.policy ?? ""}`,
			type: `${s.type ?? ""}`, mixer: `${s.mixer ?? ""}`,
			channels: (type(s.channels) == "array") ? s.channels : [],
			names: (type(s.names) == "array") ? s.names : [],
			allow: (type(s.allow) == "array") ? s.allow : [],
			max_steps: `${s.max_steps ?? ""}`,
			after: (type(s.allowed_after) == "array") ? s.allowed_after : [],
			label: `${s.label ?? ""}`
		};
	}

	return m;
}

/* ---- inferno env sidecar (written before validation, shell parity) -------- */

/* uci format (the camilladsp <-> inferno-plugin ALSA boundary) -> inferno
 * TX wire depth. Accepts both the camilladsp file-format spellings
 * (S24_3_LE, S24_4_RJ_LE, ...) and the bare ALSA ones (S24_LE, S24_3LE);
 * unknown values keep the inferno default (24). */
function tx_wire_bits(format) {
	switch (format) {
	case "S16_LE": return 16;
	case "S32_LE": return 32;
	default: return 24;
	}
}

function write_env_sidecar(m, cursor, out) {
	let cap_inf = (m.main.capture == "Inferno");
	let pb_inf = (m.main.playback == "Inferno");
	if (!cap_inf && !pb_inf) return;

	let inf = section(cursor, "inferno", "main");
	let iname = `${inf.name ?? ""}`;
	if (iname == "") {
		let sys = section(cursor, "system", "@system[0]");
		iname = `${sys.hostname ?? ""}`;
	}
	if (iname == "") iname = "rk3506qemu";

	let irx = `${inf.rx_channels ?? ""}`;
	if (irx == "") irx = cap_inf ? `${m.main.channels}` : "0";
	let itx = `${inf.tx_channels ?? ""}`;
	if (itx == "") itx = pb_inf ? `${m.main.pbch}` : "0";

	let env = [
		"RUST_LOG=warn",
		`INFERNO_NAME=${iname}`,
		`INFERNO_BIND_IP=${inf.interface ?? "eth1"}`,
		`INFERNO_CLOCK_PATH=${inf.clock_path ?? "/tmp/ptp-usrvclock"}`,
		`INFERNO_RX_CHANNELS=${irx}`,
		`INFERNO_TX_CHANNELS=${itx}`,
		`INFERNO_SAMPLE_RATE=${m.main.samplerate}`
	];
	/* TX-only: the wire depth is what THIS box advertises and packs as a
	 * transmitter, derived from the uci format (S16_LE -> 16,
	 * S24_LE/S24_3LE -> 24, S32_LE -> 32, unknown -> 24). Emitted only
	 * when format is explicitly set: unset keeps the inferno upstream
	 * default. An RX-only inferno box never gets a depth line: its wire
	 * behavior is dictated by the remote transmitter's advertisement
	 * (source-driven RX). */
	if (pb_inf && m.main.format_set)
		push(env, `INFERNO_TX_BITS_PER_SAMPLE=${tx_wire_bits(m.main.format)}`);

	/* NB: RUST_LOG configures the *inferno* instance hosted inside
	 * camilladsp (tracing env filter), not camilladsp itself. */
	writefile(stem(out) + ".env", join("\n", env) + "\n");
}

/* ---- validation (fails early: never render a broken plan) ------------------ */

function validate(m) {
	if (!match(m.main.channels, /^[0-9]+$/) || int(m.main.channels) < 1)
		fail(sprintf("bad channels '%s'", m.main.channels));
	if (!match(m.main.pbch, /^[0-9]+$/) || int(m.main.pbch) < 1)
		fail(sprintf("bad output_channels '%s'", m.main.pbch));

	/* pipeline order: OPTIONAL -- a config without any pipeline_step
	 * renders a pass-through pipeline (capture maps straight to
	 * playback). It must exist and reference every step exactly once
	 * only when steps are defined. */
	if (length(m.steps) > 0 && length(m.order) == 0)
		fail("pipeline order missing (config pipeline / list step)");
	let seen = {};
	for (let n in m.order) {
		if (!m.steps[n])
			fail(sprintf("pipeline order references unknown step '%s'", n));
		if (seen[n]) fail(sprintf("pipeline order lists step '%s' more than once", n));
		seen[n] = true;
	}
	for (let n, st in m.steps)
		if (!seen[n])
			fail(sprintf("step '%s' is not listed in the pipeline order", n));

	/* protected vs plain: when any step carries a policy, all must */
	let protected_cfg = false;
	for (let n, st in m.steps)
		if (st.policy != "") protected_cfg = true;
	if (protected_cfg)
		for (let n, st in m.steps)
			if (st.policy == "")
				fail(sprintf("step '%s' has no policy (locked|child|free)", n));

	m.protected = protected_cfg;
	if (!protected_cfg) return;

	for (let n, st in m.steps) {
		if (st.policy != "locked" && st.policy != "child" && st.policy != "free")
			fail(sprintf("step '%s': bad policy '%s' (locked|child|free)", n, st.policy));
		if (st.policy != "locked") {
			if (length(st.channels) == 0)
				fail(sprintf("step '%s' (policy %s) needs channels=", n, st.policy));
			if (length(st.allow) == 0)
				fail(sprintf("step '%s' (policy %s) needs allow=", n, st.policy));
			if (st.max_steps == "") st.max_steps = "8";
			if (st.type != "")
				fail(sprintf("step '%s' (policy %s) must not carry a type", n, st.policy));
		} else if (st.type == "") {
			fail(sprintf("step '%s' (locked) missing type", n));
		}
	}

	/* the last pipeline entry must be locked: nothing follows the tail */
	if (length(m.order) > 0) {
		let last = m.order[length(m.order) - 1];
		if (m.steps[last].policy != "locked")
			fail(sprintf("last step '%s' must be locked", last));
	}

	/* child/free slots: user filters defined + allowed + within max_steps */
	for (let n, st in m.steps) {
		if (st.policy == "locked") continue;
		let cntu = 0;
		for (let fname in st.names) {
			let f = m.filters[fname];
			if (!f) fail(sprintf("step '%s': user filter '%s' is not defined", n, fname));
			if (!has_word(st.allow, f.type))
				fail(sprintf("step '%s': filter type '%s' (of '%s') not in allow list", n, f.type, fname));
			cntu++;
		}
		if (match(st.max_steps, /^[0-9]+$/) && cntu > int(st.max_steps))
			fail(sprintf("step '%s': %d user steps exceed max_steps=%s", n, cntu, st.max_steps));
	}

	/* free steps: allowed_after must name locked steps */
	for (let n, st in m.steps) {
		if (st.policy != "free") continue;
		for (let a in st.after) {
			let anchor = m.steps[a];
			if (!anchor)
				fail(sprintf("free step '%s': allowed_after references unknown step '%s'", n, a));
			if (anchor.policy != "locked")
				fail(sprintf("free step '%s': allowed_after '%s' is not locked", n, a));
		}
	}

	/* locked conv filters must use the vendor read-only coefficient path */
	for (let n, st in m.steps) {
		if (st.policy != "locked") continue;
		for (let fname in st.names) {
			let f = m.filters[fname];
			if (f && f.type == "conv" &&
			    substr(f.filename, 0, length(VENDOR_COEFF_PREFIX) + 1) != VENDOR_COEFF_PREFIX + "/")
				fail(sprintf("locked step '%s': conv filter '%s' filename must be under %s", n, fname, VENDOR_COEFF_PREFIX));
		}
	}
}

/* ---- devices ---------------------------------------------------------------- */

function render_device(m, capture) {
	let spec = capture ? m.main.capture : m.main.playback;
	let type = spec, val = "";
	let i = index(spec, ":");
	if (i >= 0) { type = substr(spec, 0, i); val = substr(spec, i + 1); }

	let ch = int(m.main.channels);
	let pbch = int(m.main.pbch);
	let fmt = m.main.format;
	let wavhdr = !match(m.main.wav_header, /^(0|no|off|false)$/);

	if (capture) {
		if (type == "WavFile") return { type: "WavFile", filename: val };
		if (type == "RawFile") return { type: "RawFile", channels: ch, filename: val, format: fmt };
		if (type == "Alsa") return { type: "Alsa", channels: ch, device: val };
		if (type == "Inferno" && i < 0) {
			/* Dante RX via the inferno ALSA plugin (settings:
			 * /etc/config/inferno, exported as INFERNO_* env) */
			return { type: "Alsa", channels: ch, device: "inferno" };
		}
		if (type == "Stdin") return { type: "Stdin", channels: ch, format: fmt };
		fail(sprintf("unknown capture spec: %s", spec));
	}

	if (type == "File")
		return { type: "File", channels: pbch, filename: val, format: fmt, wav_header: wavhdr };
	if (type == "Alsa") return { type: "Alsa", channels: pbch, device: val };
	if (type == "Inferno" && i < 0)
		/* Dante TX via the inferno ALSA plugin */
		return { type: "Alsa", channels: pbch, device: "inferno" };
	if (type == "Stdout") return { type: "Stdout", channels: pbch, format: fmt };
	fail(sprintf("unknown playback spec: %s", spec));
}

/* ---- filters ------------------------------------------------------------------ */

function render_filter(name, f) {
	if (f.type == "") fail(sprintf("filter '%s' missing type", name));

	let t, p;

	switch (f.type) {
		case "gain":
			if (f.gain == "") fail(sprintf("filter '%s' (gain) needs gain=", name));
			t = "Gain";
			p = { gain: num(f.gain, 0) };
			if (f.inverted == "1") p.inverted = true;
			if (f.mute == "1") p.mute = true;
			break;

		case "volume":
			if (f.fader == "") fail(sprintf("filter '%s' (volume) needs fader=", name));
			t = "Volume";
			p = { fader: f.fader };
			if (f.ramp_time != "") p.ramp_time = num(f.ramp_time, 0);
			if (f.limit != "") p.limit = num(f.limit, 0);
			break;

		case "conv":
			if (f.filename == "") fail(sprintf("filter '%s' (conv) needs filename=", name));
			t = "Conv";
			p = { type: "Raw", format: "TEXT", filename: f.filename };
			break;

		case "limiter":
			if (f.clip_limit == "") fail(sprintf("filter '%s' (limiter) needs clip_limit=", name));
			t = "Limiter";
			p = { clip_limit: num(f.clip_limit, 0) };
			if (f.inverted == "1") p.soft_clip = true;
			break;

		case "hp":
		case "lp":
			if (f.f == "") fail(sprintf("filter '%s' (%s) needs f=", name, f.type));
			t = "Biquad";
			p = {
				type: (f.type == "hp") ? "Highpass" : "Lowpass",
				freq: num(f.f, 0),
				q: num((f.q != "") ? f.q : "0.707", 0)
			};
			break;

		case "lrhp":
		case "lrlp":
			if (f.f == "") fail(sprintf("filter '%s' (%s) needs f=", name, f.type));
			t = "BiquadCombo";
			p = {
				type: (f.type == "lrhp") ? "LinkwitzRileyHighpass" : "LinkwitzRileyLowpass",
				freq: num(f.f, 0),
				order: num((f.order != "") ? f.order : "4", 0)
			};
			break;

		case "hs":
		case "ls":
			if (f.f == "" || f.gain == "")
				fail(sprintf("filter '%s' (%s) needs f= and gain=", name, f.type));
			t = "Biquad";
			p = {
				type: (f.type == "hs") ? "Highshelf" : "Lowshelf",
				freq: num(f.f, 0),
				gain: num(f.gain, 0)
			};
			if (f.slope != "") p.slope = num(f.slope, 0);
			else p.q = num((f.q != "") ? f.q : "0.707", 0);
			break;

		case "peak":
			if (f.f == "" || f.gain == "")
				fail(sprintf("filter '%s' (peak) needs f= and gain=", name));
			t = "Biquad";
			p = {
				type: "Peaking",
				freq: num(f.f, 0),
				gain: num(f.gain, 0),
				q: num((f.q != "") ? f.q : "1.0", 0)
			};
			break;

		case "notch":
		case "ap":
			if (f.f == "") fail(sprintf("filter '%s' (%s) needs f=", name, f.type));
			t = "Biquad";
			p = {
				type: (f.type == "notch") ? "Notch" : "Allpass",
				freq: num(f.f, 0),
				q: num((f.q != "") ? f.q : "0.707", 0)
			};
			break;

		case "bp":
			if (f.f == "") fail(sprintf("filter '%s' (bp) needs f=", name));
			t = "Biquad";
			p = { type: "Bandpass", freq: num(f.f, 0), q: num((f.q != "") ? f.q : "0.707", 0) };
			break;

		default:
			fail(sprintf("filter '%s': unknown type '%s'", name, f.type));
	}

	let def = { type: t, parameters: p };
	if (f.description != "") def.description = f.description;
	return def;
}

/* ---- config + policy rendering -------------------------------------------------- */

function render(m) {
	let cfg = {
		devices: {
			samplerate: num(m.main.samplerate, 44100),
			chunksize: num(m.main.chunksize, 1024),
			capture: render_device(m, true),
			playback: render_device(m, false)
		}
	};

	/* mixers */
	if (length(m.mixer_order) > 0) {
		let mixers = {};
		for (let name in m.mixer_order) {
			let mx = m.mixers[name];
			let nin = (mx.in != "" && match(mx.in, /^[0-9]+$/)) ? int(mx.in) : 2;
			let nout = (mx.out != "" && match(mx.out, /^[0-9]+$/)) ? int(mx.out) : 2;
			let mapping = [];
			for (let d = 0; d < nout; d++) {
				let entry = null;
				for (let r in m.routes) {
					if (r.mixer != name || r.dest != `${d}`) continue;
					if (entry == null) {
						entry = { dest: d, sources: [] };
						push(mapping, entry);
					}
					/* uci mixer gain is LINEAR (default 1.0); v4 reads a
					 * bare gain as dB -> always emit gain + scale linear */
					let src = {
						channel: num(r.source, 0),
						gain: num((r.gain != "") ? r.gain : "1.0", 1.0),
						scale: "linear"
					};
					if (r.inverted == "1") src.inverted = true;
					if (r.mute == "1") src.mute = true;
					push(entry.sources, src);
				}
			}
			mixers[name] = { channels: { in: nin, out: nout }, mapping: mapping };
		}
		cfg.mixers = mixers;
	}

	/* filters: transparent slot anchors (Gain 0 dB) first, then defs */
	let slots = [];
	if (m.protected)
		for (let n in m.order)
			if (m.steps[n].policy != "locked")
				push(slots, n);

	if (length(m.filter_order) > 0 || length(slots) > 0) {
		let filters = {};
		for (let n in slots) {
			let ph = `user_slot_${n}`;
			filters[ph] = { type: "Gain", parameters: { gain: 0 } };
		}
		for (let n in m.filter_order)
			filters[n] = render_filter(n, m.filters[n]);
		cfg.filters = filters;
	}

	/* pipeline (in config pipeline list order) */
	let pipe = [];
	for (let n in m.order) {
		let st = m.steps[n];

		/* editable slot: render the placeholder step */
		if (m.protected && st.policy != "locked") {
			let names = [`user_slot_${n}`];
			for (let fname in st.names) push(names, fname);
			let step = {
				type: "Filter",
				channels: map(st.channels, (c) => num(c, c)),
				names: names
			};
			if (st.label != "") step.description = st.label;
			push(pipe, step);
			continue;
		}

		if (st.type == "Filter" || st.type == "filter") {
			let names = [];
			for (let fname in st.names) {
				if (!m.filters[fname])
					fail(sprintf("step '%s' references unknown filter '%s'", n, fname));
				push(names, fname);
			}
			if (length(names) == 0) fail("Filter step needs list names");
			let step = { type: "Filter" };
			if (length(st.channels) > 0)
				step.channels = map(st.channels, (c) => num(c, c));
			step.names = names;
			if (st.label != "") step.description = st.label;
			push(pipe, step);
		} else if (st.type == "Mixer" || st.type == "mixer") {
			if (!m.mixers[st.mixer])
				fail(sprintf("step '%s' references unknown mixer '%s'", n, st.mixer));
			let step = { type: "Mixer", name: st.mixer };
			if (st.label != "") step.description = st.label;
			push(pipe, step);
		} else {
			fail(sprintf("step '%s' has bad type '%s' (Filter|Mixer)", n, st.type));
		}
	}
	if (length(pipe) > 0) cfg.pipeline = pipe;

	/* policy spec (only for protected configs) */
	if (!m.protected)
		return { config: cfg, policy: null };

	let subs = [];
	for (let n in m.order) {
		let st = m.steps[n];
		let pos = index(m.order, n);
		if (st.policy == "locked") {
			/* each locked step is its own single-step anchor */
			push(subs, { policy: "locked", name: n, first_step: pos, steps: 1 });
		} else if (st.policy == "child") {
			push(subs, {
				policy: "child", name: n,
				channels: map(st.channels, (c) => num(c, c)),
				allow: st.allow,
				max_steps: match(st.max_steps, /^[0-9]+$/) ? int(st.max_steps) : st.max_steps
			});
		} else {
			push(subs, {
				policy: "free", name: n,
				gaps: st.after,
				channels: map(st.channels, (c) => num(c, c)),
				allow: st.allow,
				max_steps: match(st.max_steps, /^[0-9]+$/) ? int(st.max_steps) : st.max_steps
			});
		}
	}

	let pol = { subchains: subs };
	let truthy = { "1": true, "yes": true, "on": true, "true": true };
	let ug = [];
	let mixer_allow = {};
	for (let n in m.mixer_order) {
		if (!truthy[m.mixers[n].user_gains]) continue;
		push(ug, n);
		mixer_allow[n] = ["gain", ...m.mixers[n].allow];
	}
	if (length(ug) > 0) {
		pol.user_gains = ug;
		pol.mixer_allow = mixer_allow;
	}

	return { config: cfg, policy: pol };
}

/* ---- entry points --------------------------------------------------------- */

/* uci cursor: honors UCI_CONFIG_DIR/UCI_DELTA_DIR when set (test rigs) */
function uci_cursor() {
	let dir = getenv("UCI_CONFIG_DIR");
	if (dir != null && `${dir}` != "")
		return uci.cursor(dir, getenv("UCI_DELTA_DIR") ?? "/tmp/.uci");
	return uci.cursor();
}

/* Render + write everything for the uci state. Raises a die() exception
 * on validation failure (the caller decides how to report it). */
function generate(out) {
	let cursor = uci_cursor();

	let m = collect(cursor);          /* structural collection errors */
	write_env_sidecar(m, cursor, out); /* written pre-validation */
	validate(m);

	let r = render(m);
	writefile(out, sprintf("%J\n", r.config));
	if (r.policy != null)
		writefile(stem(out) + ".policy", sprintf("%J\n", r.policy));
}

/* CLI entry: camilladsp-genconf [outfile] */
function main(argv) {
	let out = (length(argv) > 0 && `${argv[0]}` != "") ? argv[0] : "/tmp/camilladsp.yml";

	try {
		generate(out);
	} catch (e) {
		let msg = (type(e) == "string") ? e : (e?.message ?? sprintf("%J", e));
		warn(`camilladsp-genconf: ${msg}\n`);
		exit(1);
	}
}

/* CLI entry point */
main(ARGV);

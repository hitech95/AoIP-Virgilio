+    fn call_method(object: &mut UbusObject, name: &str, args: &[u8]) -> BlobMsgTable {
+        let method = object
+            .methods
+            .iter_mut()
+            .find(|m| m.name == name)
+            .unwrap_or_else(|| panic!("no method {name}"));
+        (method.handler)(args).expect("handler failed")
+    }
+
+    #[test]
+    fn status_reply_carries_shared_state() {
+        let (shared, _state_rx) = fixture_shared_data();
+        let mut object = build_object(&shared);
+        let reply = call_method(&mut object, "status", &[]);
+        let fields = reply.contents();
+        assert_eq!(
+            blobmsg::lookup(fields, "state").and_then(|v| v.as_str()),
+            Some("Running")

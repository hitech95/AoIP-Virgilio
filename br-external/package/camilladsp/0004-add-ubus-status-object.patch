+    #[test]
+    fn volume_set_without_args_fails() {
+        let (shared, _state_rx) = fixture_shared_data();
+        let mut object = build_object(&shared);
+        let result = call_method_result(&mut object, "volume_set", &[]);
+        assert!(result.is_err());
+    }
+
+    fn call_method_result(
+        object: &mut UbusObject,
+        name: &str,
+        args: &[u8],
+    ) -> Result<BlobMsgTable, UbusError> {
+        let method = object
+            .methods
+            .iter_mut()
+            .find(|m| m.name == name)
+            .unwrap_or_else(|| panic!("no method {name}"));
+        (method.handler)(args)
+    }
+
+    #[test]
+    fn volume_set_updates_state_and_notifies() {
+        let (shared, state_rx) = fixture_shared_data();
+        let mut object = build_object(&shared);
+        // args table: {"volume": -20.0}
+        let args = BlobMsgTable::build(|bb| {
+            bb.put_double(Some("volume"), -20.0);
+        });
+        let reply = call_method(&mut object, "volume_set", args.contents());
+        assert_eq!(
+            blobmsg::lookup(reply.contents(), "volume").and_then(|v| v.as_f64()),
+            Some(-20.0)
+        );
+        assert_eq!(shared.processing_params.target_volume(0), -20.0);
+        // statefile side effects fired
+        assert!(shared.unsaved_state_change.load(Ordering::Relaxed));
+        assert!(state_rx.try_recv().is_ok());
+    }
+
+    #[test]
+    fn volume_set_accepts_int32_encoding_from_ubus_cli() {
+        // The ubus CLI encodes JSON integers as INT32, not DOUBLE.
+        let (shared, _state_rx) = fixture_shared_data();
+        let mut object = build_object(&shared);
+        let args = BlobMsgTable::build(|bb| {
+            bb.put_i32(Some("volume"), -10);
+            bb.put_bool(Some("mute"), true);
+        });
+        let reply = call_method(&mut object, "volume_set", args.contents());
+        assert_eq!(
+            blobmsg::lookup(reply.contents(), "volume").and_then(|v| v.as_f64()),
+            Some(-10.0)
+        );
+        assert_eq!(shared.processing_params.target_volume(0), -10.0);
+        assert!(shared.processing_params.is_mute(0));
+    }
+
+    #[test]
+    fn mute_toggle_flips_and_notifies() {
+        let (shared, state_rx) = fixture_shared_data();
+        let mut object = build_object(&shared);
+        let reply = call_method(&mut object, "mute_toggle", &[]);
+        assert_eq!(
+            blobmsg::lookup(reply.contents(), "mute").and_then(|v| v.as_bool()),
+            Some(true)
+        );
+        assert!(shared.processing_params.is_mute(0));
+        assert!(state_rx.try_recv().is_ok());
+        let reply = call_method(&mut object, "mute_toggle", &[]);
+        assert_eq!(
+            blobmsg::lookup(reply.contents(), "mute").and_then(|v| v.as_bool()),
+            Some(false)
+        );
+        assert!(!shared.processing_params.is_mute(0));
+    }

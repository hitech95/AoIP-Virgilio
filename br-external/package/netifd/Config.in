config BR2_PACKAGE_NETIFD
	bool "netifd"
	depends on BR2_USE_MMU # fork
	select BR2_PACKAGE_LIBUBOX
	select BR2_PACKAGE_UBUS
	select BR2_PACKAGE_UCI
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_LIBNL
	select BR2_PACKAGE_UCODE
	select BR2_PACKAGE_UDEBUG
	help
	  OpenWrt network interface daemon. Scope limited to static IP +
	  DHCP client (udhcpc from busybox); other protos are not installed.

	  https://git.openwrt.org/?p=project/netifd.git

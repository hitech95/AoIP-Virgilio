# 00-netstate — maintain runtime interface state in /tmp/state/network
# (uci delta format), OpenWrt netifd packaging parity.
# netifd execs /sbin/hotplug-call with ACTION=ifup|ifdown|ifupdate,
# INTERFACE=<logical name> DEVICE=<dev> for every interface event.

[ "ifup" = "$ACTION" ] && {
	uci_toggle_state network "$INTERFACE" up 1
	[ -n "$DEVICE" ] && {
		uci_toggle_state network "$INTERFACE" ifname "$DEVICE"
	}
}

+    /// Create a Sync message for a port in the master state.
+    ///
+    /// In PTPv1 the Sync message doubles as the PTPv2 Announce: it carries
+    /// the clock quality and grandmaster data the v1 master election runs
+    /// on. The identity fields are filled so that
+    /// [`PortIdentity::from_v1_header`] on the receiving side reconstructs
+    /// our own port identity, and the grandmaster data is taken from the
+    /// parent dataset, mirroring `Message::announce` for PTPv2.
+    ///
+    /// The message is always two-step: `ptp_assist` is set and the precise
+    /// transmit timestamp is delivered in a Follow_Up message (see
+    /// [`Message::follow_up`]).
+    pub(crate) fn sync(
+        global: &PtpInstanceState,
+        port_identity: PortIdentity,
+        sequence_id: u16,
+        sync_interval_log_2: i8,
+    ) -> Self {
+        let header = Header {
+            ptp_assist: true,
+            ..base_header(port_identity, sequence_id)
+        };
+
+        let time_properties_ds = &global.time_properties_ds;
+        let parent_ds = &global.parent_ds;
+
+        Message {
+            header,
+            body: MessageBody::Sync(SyncMessage {
+                header,
+                origin_timestamp: WireTimestampV1::default(),
+                epoch_number: 0, // PTPv1 epoch of a u32 seconds counter: always 0
+                current_utc_offset: time_properties_ds.current_utc_offset.unwrap_or(0),
+                // While sending as master we are the grandmaster ourselves
+                // (parent_ds mirrors default_ds after the M1/M2 decision),
+                // so describing ourselves here is the v1 equivalent of the
+                // grandmaster fields of a v2 Announce.
+                grandmaster: GrandmasterPropertiesV1 {
+                    communication_technology: 1,
+                    clock_uuid: parent_ds.grandmaster_identity.0[0..6].try_into().unwrap(),
+                    port_id: port_identity.port_number,
+                    sequence_id,
+                    clock_stratum: CLOCK_STRATUM,
+                    clock_identifier: CLOCK_IDENTIFIER,
+                    clock_variance: parent_ds
+                        .grandmaster_clock_quality
+                        .offset_scaled_log_variance as i16,
+                    // The v1 wire format has a single `preferred` bit where
+                    // v2 has priority_1; mirror the split point used by the
+                    // v2-compat mapping applied on receive (preferred maps
+                    // to 64, non-preferred to 128).
+                    preferred: parent_ds.grandmaster_priority_1 < V2_COMPAT_PRIORITY1,
+                    is_boundary_clock: false,
+                },
+                sync_interval: sync_interval_log_2,
+                local_clock_variance: global.default_ds.clock_quality.offset_scaled_log_variance
+                    as i16,
+                local_steps_removed: global.current_ds.steps_removed,
+                local_clock_stratum: CLOCK_STRATUM,
+                local_clock_identifier: CLOCK_IDENTIFIER,
+                parent_communication_technology: 1,
+                parent_uuid: parent_ds.parent_port_identity.clock_identity.0[0..6]
+                    .try_into()
+                    .unwrap(),
+                parent_port_field: parent_ds.parent_port_identity.port_number,
+                estimated_master_variance: 0,
+                estimated_master_drift: 0,
+                utc_reasonable: time_properties_ds.current_utc_offset.is_some(),
+            }),
+        }
+    }
+
+    /// Create a Follow_Up message carrying the transmit timestamp of the
+    /// Sync message with the given sequence id.
+    ///
+    /// The PTPv1 timestamp format has nanosecond resolution, so any
+    /// sub-nanosecond part of `timestamp` is dropped.
+    pub(crate) fn follow_up(
+        port_identity: PortIdentity,
+        sequence_id: u16,
+        timestamp: Time,
+    ) -> Self {
+        let header = base_header(port_identity, sequence_id);
+
+        Message {
+            header,
+            body: MessageBody::FollowUp(FollowUpMessage {
+                associated_sequence_id: sequence_id,
+                precise_origin_timestamp: timestamp.into(),
+            }),
+        }
+    }
+
+    /// Create a Delay_Resp message answering a received Delay_Req.
+    ///
+    /// `request_header` is the header of the received Delay_Req; the
+    /// requester identity fields required by PTPv1 are echoed from it so
+    /// the requesting port can match the response to its request.
+    pub(crate) fn delay_resp(
+        request_header: &Header,
+        port_identity: PortIdentity,
+        timestamp: Time,
+    ) -> Self {
+        let header = base_header(port_identity, request_header.sequence_id);
+
+        Message {
+            header,
+            body: MessageBody::DelayResp(DelayRespMessage {
+                receive_timestamp: timestamp.into(),
+                requesting_source_communication_technology: request_header
+                    .source_communication_technology,
+                requesting_source_uuid: request_header.source_uuid,
+                requesting_source_port_id: request_header.source_port_id,
+                requesting_source_sequence_id: request_header.sequence_id,
+            }),
+        }
+    }
+}

+    #[test]
+    fn test_delay_response_v1() {
+        let state = setup_test_state();
+
+        let mut port = setup_test_port_v1(&state);
+
+        port.set_forced_port_state(PortState::Master);
+
+        let request_header = messages_v1::Header {
+            source_communication_technology: 1,
+            source_uuid: [0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff],
+            source_port_id: 21,
+            sequence_id: 4711,
+            ..Default::default()
+        };
+
+        let timestamp = Time::from_micros(1234);
+        let mut action = port.handle_delay_req_v1(request_header, timestamp);
+
+        let Some(PortAction::SendGeneral {
+            data,
+            link_local: false,
+        }) = action.next()
+        else {
+            panic!("Unexpected resulting action");
+        };
+        assert!(action.next().is_none());
+        drop(action);
+
+        let msg = MessageV1::deserialize(data).unwrap();
+
+        // the response identifies us as its source
+        assert_eq!(
+            PortIdentity::from_v1_header(&msg.header),
+            port.port_identity
+        );
+
+        let messages_v1::MessageBody::DelayResp(msg) = msg.body else {
+            panic!("Unexpected message type");
+        };
+
+        // requester identity is echoed from the delay request header
+        assert_eq!(
+            msg.requesting_source_uuid,
+            [0xaa, 0xbb, 0xcc, 0xdd, 0xee, 0xff]
+        );
+        assert_eq!(msg.requesting_source_port_id, 21);
+        assert_eq!(msg.requesting_source_sequence_id, 4711);
+        assert_eq!(Time::from(msg.receive_timestamp), timestamp);
+
+        // a non-master port never answers delay requests
+        port.set_forced_port_state(PortState::Slave(crate::port::state::SlaveState::new(
+            PortIdentity::default(),
+        )));
+        let mut action = port.handle_delay_req_v1(request_header, timestamp);
+        assert!(action.next().is_none());
+    }

+    /// Full PTPv1 exchange between a master port and a slave port through
+    /// their public receive entry points: Sync + Follow_Up produce a sync
+    /// measurement on the slave, Delay_Req + Delay_Resp produce the delay
+    /// measurement. This is the in-process equivalent of the two-guest rig.
+    #[test]
+    fn test_v1_master_slave_exchange() {
+        use crate::port::state::SlaveState;
+        use crate::port::tests::{setup_test_port_custom_filter, setup_test_port_custom_identity};
+        use crate::time::Duration;
+        use std::borrow::ToOwned;
+
+        let master_identity = PortIdentity {
+            clock_identity: crate::config::ClockIdentity([1, 2, 3, 4, 5, 6, 0, 0]),
+            port_number: 1,
+        };
+
+        // master instance with datasets as they look after the M1 master
+        // decision (parent = self)
+        let master_state = setup_test_state();
+        {
+            let mut state = master_state.borrow_mut();
+            state.default_ds.clock_identity = master_identity.clock_identity;
+            state.parent_ds.parent_port_identity = master_identity;
+            state.parent_ds.grandmaster_identity = master_identity.clock_identity;
+        }
+
+        let mut master_port = setup_test_port_custom_identity(&master_state, master_identity);
+        master_port.config.protocol_version = ProtocolVersion::PTPv1;
+        master_port.set_forced_port_state(PortState::Master);
+
+        // slave instance that already selected the master
+        let slave_state = setup_test_state();
+        {
+            let mut state = slave_state.borrow_mut();
+            state.parent_ds.parent_port_identity = master_identity;
+        }
+
+        let mut slave_port = setup_test_port_custom_filter::<TestFilter>(&slave_state, ());
+        slave_port.config.protocol_version = ProtocolVersion::PTPv1;
+        slave_port.set_forced_port_state(PortState::Slave(SlaveState::new(master_identity)));
+
+        // symmetric 500us path between the two
+        let t_sync_send = Time::from_micros(1_000_000);
+        let t_sync_recv = Time::from_micros(1_000_500);
+
+        // ---- Sync (event) ----
+        let mut actions = master_port.send_sync();
+        assert!(matches!(
+            actions.next(),
+            Some(PortAction::ResetSyncTimer { .. })
+        ));
+        let Some(PortAction::SendEvent { context, data, .. }) = actions.next() else {
+            panic!("Unexpected action");
+        };
+        let sync_packet = data.to_owned();
+        let TimestampContextInner::Sync { id: sync_id } = context.inner else {
+            panic!("Wrong type of context");
+        };
+        drop(actions);
+
+        // slave receives it: registers the master (announce data rides
+        // along) and stores the receive time, expecting a follow up
+        let mut actions = slave_port.handle_event_receive(&sync_packet, t_sync_recv);
+        assert!(matches!(
+            actions.next(),
+            Some(PortAction::ResetAnnounceReceiptTimer { .. })
+        ));
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        // ---- Follow_Up (general), carrying the sync send timestamp ----
+        let mut actions = master_port.handle_sync_timestamp(sync_id, t_sync_send);
+        let Some(PortAction::SendGeneral { data, .. }) = actions.next() else {
+            panic!("Unexpected action");
+        };
+        let follow_up_packet = data.to_owned();
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        let mut actions = slave_port.handle_general_receive(&follow_up_packet);
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        // sync measurement: raw offset +500us, no delay known yet
+        assert_eq!(
+            slave_port.filter.last_measurement.take(),
+            Some(crate::port::Measurement {
+                event_time: t_sync_recv,
+                offset: None,
+                delay: None,
+                peer_delay: None,
+                raw_sync_offset: Some(Duration::from_micros(500)),
+                raw_delay_offset: None,
+            })
+        );
+
+        // ---- Delay_Req (event, from slave) ----
+        let t_delay_send = Time::from_micros(2_000_000);
+        let t_delay_recv = Time::from_micros(2_000_500);
+
+        let mut actions = slave_port.send_delay_request();
+        assert!(matches!(
+            actions.next(),
+            Some(PortAction::ResetDelayRequestTimer { .. })
+        ));
+        let Some(PortAction::SendEvent { context, data, .. }) = actions.next() else {
+            panic!("Unexpected action");
+        };
+        let delay_req_packet = data.to_owned();
+        drop(actions);
+
+        // master answers with a Delay_Resp echoing the requester identity
+        let mut actions = master_port.handle_event_receive(&delay_req_packet, t_delay_recv);
+        let Some(PortAction::SendGeneral { data, .. }) = actions.next() else {
+            panic!("Unexpected action");
+        };
+        let delay_resp_packet = data.to_owned();
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        // slave learns its own delay request send time, then the response
+        let mut actions = slave_port.handle_send_timestamp(context, t_delay_send);
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        let mut actions = slave_port.handle_general_receive(&delay_resp_packet);
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        // delay measurement: path delay 500us
+        assert_eq!(
+            slave_port.filter.last_measurement.take(),
+            Some(crate::port::Measurement {
+                event_time: t_delay_send,
+                offset: None,
+                delay: Some(Duration::from_micros(500)),
+                peer_delay: None,
+                raw_sync_offset: None,
+                raw_delay_offset: Some(Duration::from_micros(-500)),
+            })
+        );
+        assert_eq!(slave_port.mean_delay, Some(Duration::from_micros(500)));
+    }

+    #[test]
+    fn test_sync_v1() {
+        let state = setup_test_state();
+
+        let mut port = setup_test_port_v1(&state);
+
+        // in slave state a v1 port must not send syncs
+        port.set_forced_port_state(PortState::Slave(crate::port::state::SlaveState::new(
+            PortIdentity::default(),
+        )));
+        let mut actions = port.send_sync();
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        port.set_forced_port_state(PortState::Master);
+
+        let mut actions = port.send_sync();
+
+        assert!(matches!(
+            actions.next(),
+            Some(PortAction::ResetSyncTimer { .. })
+        ));
+        let Some(PortAction::SendEvent {
+            context,
+            data,
+            link_local: false,
+        }) = actions.next()
+        else {
+            panic!("Unexpected action");
+        };
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        let sync = MessageV1::deserialize(data).unwrap();
+        assert_eq!(
+            PortIdentity::from_v1_header(&sync.header),
+            port.port_identity
+        );
+        // two step: the follow up carries the actual send timestamp
+        assert!(sync.header.ptp_assist);
+        let messages_v1::MessageBody::Sync(sync_body) = &sync.body else {
+            panic!("Unexpected message type");
+        };
+        // master data: ourselves as grandmaster
+        assert_eq!(
+            sync_body.grandmaster.clock_uuid,
+            port.port_identity.clock_identity.0[0..6]
+        );
+        assert_eq!(sync_body.sync_interval, 0); // from the test config: 1s
+
+        let TimestampContextInner::Sync { id } = context.inner else {
+            panic!("Wrong type of context");
+        };
+        assert_eq!(id, sync.header.sequence_id);
+
+        // transmit timestamp comes back -> follow up with same sequence id
+        let timestamp = Time::from_micros(601);
+        let mut actions = port.handle_sync_timestamp(id, timestamp);
+
+        let Some(PortAction::SendGeneral {
+            data,
+            link_local: false,
+        }) = actions.next()
+        else {
+            panic!("Unexpected action");
+        };
+        assert!(actions.next().is_none());
+        drop(actions);
+
+        let follow_up = MessageV1::deserialize(data).unwrap();
+        assert_eq!(follow_up.header.sequence_id, sync.header.sequence_id);
+        let messages_v1::MessageBody::FollowUp(follow_up_body) = &follow_up.body else {
+            panic!("Unexpected message type");
+        };
+        assert_eq!(follow_up_body.associated_sequence_id, id);
+        assert_eq!(
+            Time::from(follow_up_body.precise_origin_timestamp),
+            timestamp
+        );
+
+        // next sync gets a fresh sequence id
+        let mut actions = port.send_sync();
+        assert!(matches!(
+            actions.next(),
+            Some(PortAction::ResetSyncTimer { .. })
+        ));
+        let Some(PortAction::SendEvent { data, .. }) = actions.next() else {
+            panic!("Unexpected action");
+        };
+        drop(actions);
+
+        let sync2 = MessageV1::deserialize(data).unwrap();
+        assert_ne!(sync2.header.sequence_id, sync.header.sequence_id);
+    }

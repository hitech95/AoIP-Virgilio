+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{
+        config::InstanceConfig,
+        datastructures::datasets::{InternalDefaultDS, InternalParentDS, PathTraceDS},
+    };
+
+    fn test_state() -> PtpInstanceState {
+        let default_ds = InternalDefaultDS::new(InstanceConfig {
+            clock_identity: crate::config::ClockIdentity([
+                0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc, 0, 1,
+            ]),
+            priority_1: 10,
+            priority_2: 128,
+            domain_number: 0,
+            slave_only: false,
+            sdo_id: Default::default(),
+            path_trace: false,
+        });
+
+        PtpInstanceState {
+            parent_ds: InternalParentDS::new(default_ds),
+            default_ds,
+            current_ds: Default::default(),
+            time_properties_ds: Default::default(),
+            path_trace_ds: PathTraceDS::new(false),
+        }
+    }
+
+    fn test_identity() -> PortIdentity {
+        // The v1 wire format only carries a 6 byte UUID, so identities with
+        // non-zero trailing bytes do not round-trip (statime-linux derives
+        // MAC-based identities which always have zero tails).
+        PortIdentity {
+            clock_identity: crate::config::ClockIdentity([
+                0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc, 0, 0,
+            ]),
+            port_number: 7,
+        }
+    }
+
+    #[test]
+    fn roundtrip_sync() {
+        let message = Message::sync(&test_state(), test_identity(), 4711, -3);
+
+        let mut buffer = [0; MAX_DATA_LEN];
+        let len = message.serialize(&mut buffer).unwrap();
+        assert_eq!(len, 40 + 84);
+
+        let parsed = Message::deserialize(&buffer[..len]).unwrap();
+        assert_eq!(parsed, message);
+    }
+
+    #[test]
+    fn sync_carries_master_data() {
+        let message = Message::sync(&test_state(), test_identity(), 4711, -3);
+
+        // A statime slave must reconstruct our port identity from the header
+        assert_eq!(
+            PortIdentity::from_v1_header(&message.header),
+            test_identity()
+        );
+        // Two-step: the precise timestamp arrives in a follow up
+        assert!(message.header.ptp_assist);
+
+        let MessageBody::Sync(sync) = &message.body else {
+            panic!("wrong message type");
+        };
+        // Election data: us as grandmaster
+        assert_eq!(
+            sync.grandmaster.clock_uuid,
+            [0x12, 0x34, 0x56, 0x78, 0x9a, 0xbc]
+        );
+        assert!(sync.grandmaster.preferred); // priority_1 = 10 < 128
+        assert_eq!(sync.sync_interval, -3);
+        assert_eq!(sync.local_steps_removed, 0);
+    }
+
+    #[test]
+    fn roundtrip_follow_up() {
+        let timestamp = Time::from_micros(1_234_567);
+        let message = Message::follow_up(test_identity(), 815, timestamp);
+
+        let mut buffer = [0; MAX_DATA_LEN];
+        let len = message.serialize(&mut buffer).unwrap();
+        assert_eq!(len, 40 + 12);
+
+        let parsed = Message::deserialize(&buffer[..len]).unwrap();
+        assert_eq!(parsed, message);
+    }
+
+    #[test]
+    fn follow_up_timestamp_resolution() {
+        // sub-nanosecond parts do not survive the v1 wire format
+        use fixed::types::U96F32;
+        let timestamp =
+            Time::from_fixed_nanos(U96F32::from_bits((1_234_567_891_u128 << 32) + (1 << 16)));
+        let message = Message::follow_up(test_identity(), 815, timestamp);
+
+        let MessageBody::FollowUp(follow_up) = &message.body else {
+            panic!("wrong message type");
+        };
+        assert_eq!(follow_up.precise_origin_timestamp.seconds, 1);
+        assert_eq!(follow_up.precise_origin_timestamp.nanos, 234_567_891);
+        assert_ne!(Time::from(follow_up.precise_origin_timestamp), timestamp);
+    }
+
+    #[test]
+    fn roundtrip_delay_resp() {
+        let request_header = Header {
+            source_communication_technology: 1,
+            source_uuid: [0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54],
+            source_port_id: 33,
+            sequence_id: 999,
+            ..Default::default()
+        };
+        let timestamp = Time::from_micros(7_654_321);
+        let message = Message::delay_resp(&request_header, test_identity(), timestamp);
+
+        let mut buffer = [0; MAX_DATA_LEN];
+        let len = message.serialize(&mut buffer).unwrap();
+        assert_eq!(len, 40 + 20);
+
+        let parsed = Message::deserialize(&buffer[..len]).unwrap();
+        assert_eq!(parsed, message);
+
+        let MessageBody::DelayResp(resp) = &parsed.body else {
+            panic!("wrong message type");
+        };
+        // requester identity is echoed so the slave can match the response
+        assert_eq!(
+            resp.requesting_source_uuid,
+            [0xfe, 0xdc, 0xba, 0x98, 0x76, 0x54]
+        );
+        assert_eq!(resp.requesting_source_port_id, 33);
+        assert_eq!(resp.requesting_source_sequence_id, 999);
+        assert_eq!(resp.receive_timestamp.seconds, 7);
+        assert_eq!(resp.receive_timestamp.nanos, 654_321_000);
+    }
 }

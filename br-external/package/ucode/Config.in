config BR2_PACKAGE_UCODE
	bool "ucode"
	depends on BR2_USE_MMU # fork
	select BR2_PACKAGE_LIBUBOX
	select BR2_PACKAGE_LIBJSON_C
	select BR2_PACKAGE_ZLIB
	help
	  Tiny scripting language VM, required by netifd for its ucode
	  protocol handlers. Pinned to OpenWrt 25.12.5 (8592205).

	  https://github.com/jow-/ucode

 use crate::protocol::proto_arc::PORT as ARC_PORT;
 use crate::protocol::proto_cmc::PORT as CMC_PORT;
 
+// First global (non-link-local) IPv4 of an interface, falling back to
+// its first address: in the combined topology a DHCP/static global and
+// an RFC 3927 link-local (zcip) coexist on one device and the
+// first-found order is arbitrary — peers on a managed network must
+// reach us at the global address. Link-local-only regimes (standalone
+// segment, no infrastructure) are unaffected by the preference.
+fn preferred_ipv4(nets: &[netdev::ipnet::Ipv4Net]) -> Option<Ipv4Addr> {
+  nets.iter().find(|net| !net.addr().is_link_local()).or_else(|| nets.first()).map(|net| net.addr())

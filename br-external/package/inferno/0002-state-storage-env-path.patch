+    // and embedded setups want state on a dedicated persistent volume.
+    // Final layout is always <base>/inferno_aoip/<factory-device-id>/.
+    let mut dir = match state_base {
+      Some(p) => {
+        let mut p = p;
+        p.push("inferno_aoip");
+        p
+      }
+      None => AppDirs::new(Some("inferno_aoip"), false).unwrap().state_dir,
+    };
+    dir.push(hex::encode(self_info.factory_device_id));

config BR2_PACKAGE_INFERNO
	bool "inferno"
	depends on BR2_USE_MMU # Rust
	select BR2_PACKAGE_ALSA_LIB
	help
	  Unofficial implementation of the Dante protocol (Audio over IP).
	  Binaries: inferno2pipe; ALSA plugin: alsa_pcm_inferno. Ships the
	  uci defaults (/etc/config/inferno); boards override them via
	  their rootfs overlay where needed.

	  https://github.com/teodly/inferno

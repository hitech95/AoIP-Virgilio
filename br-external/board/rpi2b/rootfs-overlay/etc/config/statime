# statime on the rpi2b: board override of the package default — the
# single onboard NIC is eth0 (package default expects the rig's eth1).
# Everything else matches the package default.

config statime 'main'
	option loglevel 'warn'
	option domain '0'
	option sdo_id '0'
	option priority1 '251'
	option slave_only '0'
	option interface 'eth0'
	option network_mode 'ipv4'
	option hardware_clock 'auto'
	option protocol 'PTPv2'
	option virtual_system_clock '1'
	option virtual_system_clock_base 'monotonic_raw'
	option usrvclock_export '1'
	option usrvclock_path '/tmp/ptp-usrvclock'

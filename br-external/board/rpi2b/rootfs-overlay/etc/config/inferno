# inferno on the rpi2b: board override of the package default — binds the
# logical 'aoip' netifd interface (network.aoip.device = the single
# onboard NIC; genconf/statime resolve it to the netdev name).

config inferno 'main'
	option name ''
	option interface 'aoip'
	option clock_path '/tmp/ptp-usrvclock'
	option state_dir '/opt/user_data'
	option rx_channels ''
	option tx_channels ''

# Enable busybox ntpd for /etc/init.d/sysntpd
CONFIG_NTPD=y
CONFIG_FEATURE_NTPD_SERVER=y
# ipcalc.sh (awk script) needs awk math functions (and/or/rshift/compl)
CONFIG_FEATURE_AWK_LIBM=y
# file exfil from guest (M3 DoD: pipeline output to host for verification)
CONFIG_NC=y
# webuid login: verify /etc/shadow hashes (cryptpw PASSWORD SALT)
CONFIG_CRYPTPW=y
# zcip: RFC 3927 IPv4 link-local addressing for the AoIP interface (netifd
# proto 'zcip', /usr/lib/netifd/proto/zcip.sh) — presence on a bare switch
CONFIG_ZCIP=y
# ifup/ifdown/ifreload are virgilio-base's netifd wrappers (usr/sbin);
# the busybox applets must not own those names (a fresh build installs
# busybox first and its applet symlinks made virgilio-base's cp write
# the wrapper THROUGH the link into the busybox binary)
# CONFIG_IFUPDOWN is not set

#!/bin/sh /etc/rc.common
# mpd - music player daemon: web-radio / media source feeding the Dante
# transmitter through the ALSA loopback (see /etc/mpd.conf).
#
# music/playlists/database/state live under /opt/user_data/mpd (the RW
# user-data partition) so they survive reboots; /var is tmpfs and would
# wipe the database on every boot.

START=96
STOP=30
USE_PROCD=1

MPD_DATA=/opt/user_data/mpd

start_service() {
	mkdir -p "$MPD_DATA"/music "$MPD_DATA"/playlist
	# NB: do NOT pre-create database/state files -- MPD treats a zero-byte
	# database as corrupted and then fails to resolve any song
	procd_open_instance
	procd_set_param command /usr/bin/mpd --no-daemon /etc/mpd.conf
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

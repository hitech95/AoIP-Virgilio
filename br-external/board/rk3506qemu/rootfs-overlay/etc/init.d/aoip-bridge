#!/bin/sh /etc/rc.common
# aoip-bridge — DEPRECATED, kept for debugging only.
#
# Sink-side Dante receiver feeding camilladsp through a FIFO:
#   inferno2pipe (rx 1..N) | aplay-free variant → /tmp/aoip.fifo
#     → camilladsp capture 'RawFile:/tmp/aoip.fifo' → playback
#
# This was the workaround for the capture busy-poll bug: camilladsp
# polled the userspace inferno PCM with raw descriptors (no
# snd_pcm_poll_descriptors_revents) and spun at one pegged core. That
# is FIXED by the camilladsp patch
# 0001-capture-use-poll-descriptors-revents.patch — the sink captures
# 'Inferno' directly and this service is no longer part of the product
# path (disabled by default). Use it only to bisect capture issues:
# enable it, point camilladsp at the FIFO, and compare.
#
# If used: camilladsp uci capture='RawFile:/tmp/aoip.fifo'
# format='S32_LE'; the ARC subscription (--to <sink-ip>) is answered by
# the bridge's own inferno2pipe instance.

START=96
STOP=35
USE_PROCD=1

FIFO=/tmp/aoip.fifo

start_service() {
	local interface clock_path channels samplerate
	config_load inferno
	config_get interface main interface eth0
	config_get clock_path main clock_path /tmp/ptp-usrvclock
	config_get channels main rx_channels 2
	config_get samplerate main sample_rate 48000
	config_get state_dir main state_dir /opt/user_data
	[ -n "$channels" ] || channels=2

	[ -p "$FIFO" ] || mkfifo "$FIFO"
	mkdir -p "$state_dir"

	procd_open_instance
	procd_set_param command /usr/bin/inferno2pipe --channels-count "$channels" --output "$FIFO"
	procd_set_param env INFERNO_BIND_IP="$interface" \
		INFERNO_CLOCK_PATH="$clock_path" \
		INFERNO_SAMPLE_RATE="$samplerate" \
		INFERNO_RX_CHANNELS="$channels" \
		INFERNO_STATE_PATH="$state_dir"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

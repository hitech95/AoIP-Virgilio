#!/bin/sh /etc/rc.common
# dropbear — SSH server for bring-up/debug. Buildroot's SysV S50dropbear
# is dropped by the post-build (procd rc.d is the only init mechanism),
# so this is the procd equivalent. -R generates the host keys on the
# first connection (kept in /etc/dropbear -> overlay, persistent).
# NOTE: the root account has an EMPTY password by default: dropbear will
# not accept password login until one is set (passwd, or the webui
# password page). Key-based auth works out of the box.

START=50
STOP=50
USE_PROCD=1

start_service() {
	# Buildroot ships /etc/dropbear as a dangling symlink into volatile
	# /var/run/dropbear (keys regenerated every boot by its S50 SysV
	# script, which we drop). We keep PERSISTENT keys in the overlay:
	# remove the link (mkdir -p on a dangling symlink fails with ENOENT)
	# and use a real directory.
	[ -L /etc/dropbear ] && rm -f /etc/dropbear
	mkdir -p /etc/dropbear
	procd_open_instance
	procd_set_param command /usr/sbin/dropbear -F -E -R -p 22
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

#!/bin/sh /etc/rc.common
# mpd - music player daemon: web-radio / media source feeding the Dante
# transmitter through the ALSA loopback (see /etc/mpd.conf).

START=96
STOP=30
USE_PROCD=1

start_service() {
	mkdir -p /var/lib/mpd/music /var/lib/mpd/playlist
	# NB: do NOT pre-create database/state files -- MPD treats a zero-byte
	# database as corrupted and then fails to resolve any song
	# no shipped playlists: stations are user data -- add with
	# `mpc load <file>` / `mpd-ctl play <url>` after enabling the service
	procd_open_instance
	procd_set_param command /usr/bin/mpd --no-daemon /etc/mpd.conf
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

#!/bin/sh /etc/rc.common
# single-nic-fixup: in bridge rig mode (run-qemu.sh --net tap:if --no-mgmt)
# the guest has ONE NIC, which the kernel names eth0 — but the overlay
# config expects the Dante/PTP NIC on eth1 (dual-NIC rig mode). Retarget
# the logical 'aoip' netifd interface to eth0 once at boot; statime and
# inferno keep saying 'aoip' and follow (interface resolution:
# network.aoip.device), so both topologies work from the same image.
#   network.lan  (eth0, dhcp)  -> proto none (the mgmt NIC does not exist;
#                                 a dhcp client would discover-spam the
#                                 Dante segment and burn CPU)
#   network.aoip (eth1, none)  -> device eth0
# EXCEPTION: --net user simple mode (run-qemu.sh marks the kernel cmdline
# with virgilio-net=slirp): the single eth0 IS the management NIC — keep
# network.lan on DHCP, only retarget the AoIP device.

START=05
USE_PROCD=0

boot() {
	if ip link show eth1 >/dev/null 2>&1 || ! ip link show eth0 >/dev/null 2>&1; then
		return 0
	fi

	if grep -q 'virgilio-net=slirp' /proc/cmdline 2>/dev/null; then
		uci -q batch <<EOF
set network.aoip.device='eth0'
commit network
EOF
		echo "single-nic-fixup: no eth1, slirp simple mode: lan kept on DHCP, aoip retargeted to eth0" >&2
		return 0
	fi

	uci -q batch <<EOF
set network.lan.proto='none'
set network.aoip.device='eth0'
commit network
EOF
	echo "single-nic-fixup: no eth1, retargeted lan/aoip to eth0 (statime+inferno follow)" >&2
}
